---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconGallery from "@/assets/icons/IconGallery.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import Logo from "@/assets/logo/devosfera.svg";
import LinkButton from "./LinkButton.astro";
import MobileMenu from "./MobileMenu.astro";
import IntroAudioCompact from "./IntroAudioCompact.astro";
import { SITE } from "@/config";
import { useTranslations, getTargetLanguageUrl } from "@/i18n/utils";

const { pathname } = Astro.url;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale as any);
const targetLocale = locale === "es" ? "en" : "es";
const targetLanguageUrl = getTargetLanguageUrl(pathname, targetLocale);
const langToggleTitle = locale === "es" ? "Switch to English" : "Cambiar a Español";
const langToggleLabel = locale === "es" ? "Switch to English" : "Cambiar a Español";

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  let normalizedCurrent = currentPath;
  if (normalizedCurrent.startsWith("/es/") || normalizedCurrent === "/es") {
    normalizedCurrent = normalizedCurrent.slice(3) || "/";
  }
  
  const currentPathArray = normalizedCurrent.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return normalizedCurrent === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 rounded-b-lg bg-accent px-4 py-2 font-medium text-background transition-all focus:top-0"
>
  {t("nav.skip")}
</a>

<header id="main-header" class="sticky top-0 z-40 w-full transition-colors duration-300">
  <div class="header-scrolled-filter w-full">
    <div class="app-layout">
      <div
        id="top-nav-wrap"
        class:list={[
          "py-3 sm:py-5",
          "relative w-full",
          "flex items-center justify-between gap-2 sm:gap-4",
          "transition-all duration-300",
        ]}
      >
        <!-- Logo -->
        <a
          href={locale === "es" ? "/es" : "/"}
          class="group relative z-20 flex items-center gap-2 text-xl font-bold tracking-tight sm:text-2xl shrink-0"
        >
          <!-- <span class="nav-logo-text">{SITE.title}</span> -->
          <Logo class="w-37.5 dark:invert" />
        </a>

        <!-- Center Audio Player -->
        {
          SITE.introAudio.enabled && (
            <div class="flex-1 flex justify-center min-w-0">
              <IntroAudioCompact
                src={SITE.introAudio.src}
                label={SITE.introAudio.label}
                duration={SITE.introAudio.duration}
                isStream={SITE.introAudio.isStream}
                class="nav-intro-audio-compact"
              />
            </div>
          )
        }

        <!-- Nav area -->
        <nav id="nav-menu" class="flex items-center gap-1.5 lg:gap-1 shrink-0">
          <!-- Mobile search button (visible only on screens < 1024px) -->
          <button
            data-search-trigger
            class="nav-icon-btn lg:!hidden"
            title={locale === "es" ? "Buscar" : "Search"}
            aria-label={t("nav.openSearch")}
          >
            <IconSearch class="size-4.5" />
          </button>

          <!-- Mobile hamburger (animated lines) -->
          <button
            id="menu-btn"
            class="hamburger-btn lg:hidden"
            aria-label={t("nav.openMenu")}
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <div class="hamburger-box">
              <span class="hamburger-line hamburger-line--1"></span>
              <span class="hamburger-line hamburger-line--2"></span>
              <span class="hamburger-line hamburger-line--3"></span>
            </div>
          </button>

          <!-- Desktop links (always visible on lg+) -->
          <ul class="hidden lg:flex lg:flex-row lg:items-center lg:gap-1">
            <li>
              <a
                href={locale === "es" ? "/es/posts" : "/posts"}
                class:list={["nav-link", { "nav-active": isActive("/posts") }]}
                >{t("nav.posts")}</a
              >
            </li>
            <li>
              <a
                href={locale === "es" ? "/es/tags" : "/tags"}
                class:list={["nav-link", { "nav-active": isActive("/tags") }]}
                >{t("nav.tags")}</a
              >
            </li>
            <li>
              <a
                href={locale === "es" ? "/es/about" : "/about"}
                class:list={["nav-link", { "nav-active": isActive("/about") }]}
                >{t("nav.about")}</a
              >
            </li>
            <li class="flex items-center">
              <a
                href={locale === "es" ? "/es/search" : "/search"}
                class:list={["nav-link", { "nav-active": isActive("/search") }]}
                title={locale === "es" ? "Ir a Buscar" : "Go to Search"}>{t("nav.search")}</a
              >
            </li>
            {
              SITE.showArchives && (
                <li>
                  <LinkButton
                    href={locale === "es" ? "/es/archives" : "/archives"}
                    class:list={[
                      "nav-link",
                      { "nav-active": isActive("/archives") },
                    ]}
                    title={t("nav.archives")}
                    aria-label="archives"
                  >
                    <IconArchive class="hidden lg:inline-block" />
                    <span class="lg:sr-only">{t("nav.archives")}</span>
                  </LinkButton>
                </li>
              )
            }
            {
              SITE.showGalleries && (
                <li>
                  <LinkButton
                    href={locale === "es" ? "/es/galleries" : "/galleries"}
                    class:list={[
                      "nav-link",
                      { "nav-active": isActive("/galleries") },
                    ]}
                    title={t("nav.galleries")}
                    aria-label="galleries"
                  >
                    <IconGallery class="hidden lg:inline-block" />
                    <span class="lg:sr-only">{t("nav.galleries")}</span>
                  </LinkButton>
                </li>
              )
            }

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <li class="flex items-center">
              <button
                data-search-trigger
                class="nav-search-btn"
                title={locale === "es" ? "Buscar (⌘K)" : "Search (⌘K)"}
                aria-label={t("nav.openSearch")}
                aria-keyshortcuts="Meta+K"
              >
                <IconSearch class="size-4.5" />
                <kbd class="nav-kbd">⌘K</kbd>
              </button>
            </li>
            <li class="flex items-center">
              <button
                class="shortcuts-trigger nav-search-btn"
                title={locale === "es" ? "Atajos (?)" : "Shortcuts (?)"}
                aria-label={locale === "es" ? "Abrir guía de atajos de teclado" : "Open keyboard shortcuts guide"}
                aria-keyshortcuts="?"
              >
                <svg class="size-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" ry="2"></rect>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 9h.01M11 9h.01M15 9h.01M17 9h.01M7 13h.01M11 13h.01M15 13h.01M17 13h.01M9 16h6" />
                </svg>
                <kbd class="nav-kbd">?</kbd>
              </button>
            </li>
            <li class="flex items-center relative accent-picker-container">
              <button
                id="accent-btn"
                class="nav-icon-btn relative"
                title={t("nav.changeAccent")}
                aria-label={t("nav.changeAccent")}
                aria-haspopup="true"
                aria-expanded="false"
              >
                <!-- Color Swatch Icon -->
                <svg class="size-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
              </button>
              
              <div id="accent-popover" class="absolute right-0 top-10 hidden rounded-xl border border-border/20 bg-background/95 backdrop-blur-md p-2.5 shadow-xl min-w-[150px] flex flex-col gap-1.5 z-50">
                <div class="text-[10px] font-firacode font-bold tracking-wider text-foreground/45 px-1 uppercase select-none">
                  {t("nav.accentColor")}
                </div>
                <div class="flex items-center justify-between gap-1 mt-1">
                  <!-- Blue -->
                  <button data-accent-color="blue" class="size-5 rounded-full bg-[#008fec] border border-border/25 hover:scale-110 active:scale-95 transition-all focus:outline-none relative" title="Blue"></button>
                  <!-- Green -->
                  <button data-accent-color="green" class="size-5 rounded-full bg-[#10b981] border border-border/25 hover:scale-110 active:scale-95 transition-all focus:outline-none relative" title="Green"></button>
                  <!-- Purple -->
                  <button data-accent-color="purple" class="size-5 rounded-full bg-[#a855f7] border border-border/25 hover:scale-110 active:scale-95 transition-all focus:outline-none relative" title="Purple"></button>
                  <!-- Amber -->
                  <button data-accent-color="amber" class="size-5 rounded-full bg-[#f59e0b] border border-border/25 hover:scale-110 active:scale-95 transition-all focus:outline-none relative" title="Amber"></button>
                  <!-- Rose -->
                  <button data-accent-color="rose" class="size-5 rounded-full bg-[#f43f5e] border border-border/25 hover:scale-110 active:scale-95 transition-all focus:outline-none relative" title="Rose"></button>
                </div>
              </div>
            </li>
            <li class="flex items-center">
              <a
                href={targetLanguageUrl}
                class="nav-icon-btn text-xs font-bold font-firacode tracking-wider flex items-center justify-center"
                title={langToggleTitle}
                aria-label={langToggleLabel}
                data-lang-toggle={targetLocale}
              >
                {locale === "es" ? "EN" : "ES"}
              </a>
            </li>
            {
              SITE.lightAndDarkMode && (
                <li class="flex items-center">
                  <button
                    id="theme-btn"
                    class="nav-icon-btn relative"
                    title={t("nav.theme")}
                    aria-label="auto"
                    aria-live="polite"
                  >
                    <IconMoon class="absolute top-1/2 left-1/2 -translate-1/2 scale-100 rotate-0 transition-all duration-300 dark:scale-0 dark:-rotate-90" />
                    <IconSunHigh class="absolute top-1/2 left-1/2 -translate-1/2 scale-0 rotate-90 transition-all duration-300 dark:scale-100 dark:rotate-0" />
                  </button>
                </li>
              )
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>
  <MobileMenu currentPath={currentPath} />

  <!-- Bottom border with gradient -->
  <div
    id="header-border"
    class="header-border-line opacity-0 transition-opacity duration-300 h-px w-full bg-linear-to-r from-transparent via-border/40 to-transparent"
  >
  </div>
</header>

<style>
  /* ─── Header Glass & Scroll Physics ─── */
  #main-header {
    background: transparent;
  }
  
  :global(.header-scrolled) {
    background: color-mix(in srgb, var(--background) 80%, transparent) !important;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
  }

  :global(.header-scrolled .header-scrolled-filter) {
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
  }

  .nav-logo-text {
    background: linear-gradient(
      135deg,
      var(--foreground) 0%,
      var(--foreground) 60%,
      var(--accent) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :global(.nav-intro-audio-compact) {
    max-width: 100%;
  }

  /* ─── Logo SVG hover effects ─── */
  :global(.logo-text-left),
  :global(.logo-text-right) {
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.4s ease;
  }
  :global(.logo-sphere) {
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
    transform-origin: 342px 130px;
  }

  .group:hover :global(.logo-text-left) {
    transform: translateX(-5px);
    filter: drop-shadow(0 0 3px rgba(56, 66, 77, 0.2));
  }
  .group:hover :global(.logo-text-right) {
    transform: translateX(5px);
    filter: drop-shadow(0 0 3px rgba(56, 66, 77, 0.2));
  }
  .group:hover :global(.logo-sphere) {
    filter: drop-shadow(0 0 8px rgba(167, 90, 90, 0.5));
    animation: sphere-wiggle 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes sphere-wiggle {
    0% {
      transform: rotate(0deg) scale(1);
    }
    20% {
      transform: rotate(-8deg) scale(1.1);
    }
    40% {
      transform: rotate(5deg) scale(1.15);
    }
    60% {
      transform: rotate(-3deg) scale(1.12);
    }
    80% {
      transform: rotate(1deg) scale(1.05);
    }
    100% {
      transform: rotate(0deg) scale(1);
    }
  }

  /* ─── Desktop nav links ─── */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.5rem;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .nav-link:focus-visible, .nav-icon-btn:focus-visible, .nav-search-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  :is(.nav-link, .nav-icon-btn):hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .nav-active {
    color: var(--accent);
    /* Clean active state for desktop */
    background: transparent;
  }

  /* Glowing dot for active state (macOS Dock style) */
  .nav-active::after {
    content: "";
    position: absolute;
    bottom: -0.1rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .nav-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    transition: color 0.2s ease, background-color 0.2s ease;
    color: var(--foreground);
  }

  /* ─── Desktop Search Button with ⌘K ─── */
  .nav-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.5rem 0.3rem 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted-foreground);
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .nav-search-btn:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .nav-kbd {
    display: inline-flex;
    align-items: center;
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-bottom-width: 2px;
    background: color-mix(in srgb, var(--background) 90%, transparent);
    color: var(--muted-foreground);
    box-shadow: inset 0 -1px 0 rgba(0,0,0,0.1);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .nav-search-btn:hover .nav-kbd {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }

  /* ─── Animated Hamburger Button ─── */
  .hamburger-btn {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    border: 1px solid transparent;
    background: transparent;
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .hamburger-btn {
      display: none;
    }
  }

  .hamburger-btn:hover,
  .hamburger-btn[aria-expanded="true"] {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .hamburger-box {
    position: relative;
    width: 18px;
    height: 14px;
  }

  .hamburger-line {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--foreground);
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      top 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hamburger-line--1 {
    top: 0;
  }
  .hamburger-line--2 {
    top: 6px;
  }
  .hamburger-line--3 {
    top: 12px;
    width: 60%;
  }

  /* Open state: morph to X */
  .hamburger-btn[aria-expanded="true"] .hamburger-line {
    background: var(--accent);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--1 {
    top: 6px;
    transform: rotate(45deg);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--3 {
    top: 6px;
    width: 100%;
    transform: rotate(-45deg);
  }


</style>

<script>
  let headerCleanup: AbortController | null = null;
  let scrollCleanup: AbortController | null = null;

  function setupScrollPhysics() {
    if (scrollCleanup) scrollCleanup.abort();
    scrollCleanup = new AbortController();
    const { signal } = scrollCleanup;

    const header = document.getElementById("main-header");
    const navWrap = document.getElementById("top-nav-wrap");
    const borderLine = document.getElementById("header-border");

    if (!header || !navWrap || !borderLine) return;

    let rafPending = false;
    const handleScroll = () => {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 15;
        header.classList.toggle("header-scrolled", scrolled);
        navWrap.classList.toggle("sm:py-5", !scrolled);
        navWrap.classList.toggle("sm:py-3", scrolled);
        borderLine.classList.toggle("opacity-0", !scrolled);
        borderLine.classList.toggle("opacity-100", scrolled);
        rafPending = false;
      });
    };

    window.addEventListener("scroll", handleScroll, { passive: true, signal });
    handleScroll(); // Init instantly
  }

  function setupMobileNav() {
    // Cleanup previous listeners
    if (headerCleanup) headerCleanup.abort();
    headerCleanup = new AbortController();
    const { signal } = headerCleanup;

    const menuBtn = document.querySelector("#menu-btn");
    const mobileMenu = document.querySelector("#mobile-menu");
    const backdrop = document.querySelector(".mobile-menu-backdrop");

    if (!menuBtn || !mobileMenu) return;
    
    const closeMenu = () => {
      menuBtn.setAttribute("aria-expanded", "false");
      menuBtn.setAttribute("aria-label", "Open Menu");
      mobileMenu.classList.remove("is-open");
      mobileMenu.setAttribute("aria-hidden", "true");
    };

    menuBtn.addEventListener(
      "click",
      () => {
        const isOpen = menuBtn.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          closeMenu();
        } else {
          menuBtn.setAttribute("aria-expanded", "true");
          menuBtn.setAttribute("aria-label", "Close Menu");
          mobileMenu.classList.add("is-open");
          mobileMenu.setAttribute("aria-hidden", "false");
        }
      },
      { signal }
    );
    
    // Close when clicking the backdrop
    if (backdrop) {
      backdrop.addEventListener("click", closeMenu, { signal });
      window.addEventListener("scroll", closeMenu, { passive: true, signal });
    }

    // Close mobile menu on link click
    mobileMenu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", closeMenu, { signal });
    });
  }

  let accentCleanup: AbortController | null = null;

  function setupAccentPicker() {
    if (accentCleanup) accentCleanup.abort();
    accentCleanup = new AbortController();
    const { signal } = accentCleanup;

    const accentBtn = document.getElementById("accent-btn");
    const accentPopover = document.getElementById("accent-popover");

    if (!accentBtn || !accentPopover) return;

    // Toggle popover
    accentBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = accentBtn.getAttribute("aria-expanded") === "true";
      accentBtn.setAttribute("aria-expanded", !isExpanded ? "true" : "false");
      accentPopover.classList.toggle("hidden", isExpanded);
    }, { signal });

    // Close when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!accentPopover.classList.contains("hidden") && !accentPopover.contains(target) && target !== accentBtn) {
        accentBtn.setAttribute("aria-expanded", "false");
        accentPopover.classList.add("hidden");
      }
    }, { signal });

    // Accent selection logic (desktop and mobile picker buttons)
    document.querySelectorAll("[data-accent-color]").forEach(btn => {
      btn.addEventListener("click", () => {
        const color = btn.getAttribute("data-accent-color");
        if (color) {
          document.documentElement.setAttribute("data-accent", color);
          localStorage.setItem("theme-accent", color);
          
          // Also close popover if desktop button clicked
          accentBtn.setAttribute("aria-expanded", "false");
          accentPopover.classList.add("hidden");
        }
      }, { signal });
    });
  }

  // Initial load
  setupScrollPhysics();
  setupMobileNav();
  setupAccentPicker();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", () => {
    setupScrollPhysics();
    setupMobileNav();
    setupAccentPicker();
  });
</script>
