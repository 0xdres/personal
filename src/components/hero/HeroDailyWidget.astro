---
/**
 * HeroDailyWidget.astro
 *
 * Master Orchestrator Component for the 50% Right Column of the Hero Section.
 * Features:
 * - Automatically displays the active widget corresponding to the current day of the week (0 = Sunday .. 6 = Saturday).
 * - Glassmorphism 3D container with subtle neon border bloom.
 * - Explorer Mode: Locked by default; unlocked via Quiz modal to freely shuffle widgets.
 * - Dev Mode Toolbar (import.meta.env.DEV): Instant day switcher for rapid iteration.
 * - Event-driven architecture with smooth crossfade panel transitions.
 */
import { useTranslations } from "@/i18n/utils";
import type { ContentEntry } from "@/utils/contentEntry";

import WidgetBento from "./widgets/WidgetBento.astro";
import WidgetCodeSandbox from "./widgets/WidgetCodeSandbox.astro";
import WidgetPhysicsLab from "./widgets/WidgetPhysicsLab.astro";
import WidgetGameOfLife from "./widgets/WidgetGameOfLife.astro";
import WidgetSpotlightCard from "./widgets/WidgetSpotlightCard.astro";
import WidgetLaunchpad from "./widgets/WidgetLaunchpad.astro";
import WidgetDevRadar from "./widgets/WidgetDevRadar.astro";
import WidgetQuizModal from "./WidgetQuizModal.astro";
import WidgetDevToolbar from "./WidgetDevToolbar.astro";

interface Props {
  class?: string;
  featuredPost?: ContentEntry;
}

const { class: className = "", featuredPost } = Astro.props;
const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
const isEs = locale === "es";

// Compute server-side day (0 = Sunday .. 6 = Saturday) for 0-latency zero-blink SSR
const serverDay = new Date().getDay();

const DAY_NAMES_SSR: Record<number, string> = {
  1: isEs ? "Lunes • Bento Deck" : "Monday • Bento Deck",
  2: isEs ? "Martes • Code Sandbox" : "Tuesday • Code Sandbox",
  3: isEs ? "Miércoles • Laboratorio de Física" : "Wednesday • Physics Lab",
  4: isEs ? "Jueves • Game of Life" : "Thursday • Game of Life",
  5: isEs ? "Viernes • Spotlight Card" : "Friday • Spotlight Card",
  6: isEs ? "Sábado • Launchpad" : "Saturday • Launchpad",
  0: isEs ? "Domingo • Dev Radar" : "Sunday • Dev Radar",
};
---

<div class:list={["hero-daily-widget-wrapper relative w-full flex flex-col justify-center", className]}>
  <!-- Ambient Ethereal Backlight Aura (Radial breathing glow) -->
  <div class="hero-aurora-glow pointer-events-none absolute -inset-3 sm:-inset-5 -z-10 rounded-3xl opacity-75 blur-2xl sm:blur-3xl transition-all duration-700" aria-hidden="true"></div>

  <!-- Synchronous Inline Guard to prevent FOUC when a dev override day is persisted (Dev mode only) -->
  {
    import.meta.env.DEV && (
      <script is:inline>
        (function () {
          try {
            const saved = localStorage.getItem("hero-dev-selected-day");
            if (saved !== null) {
              const targetDay = Number(saved);
              const panels = document.querySelectorAll(".widget-panel");
              panels.forEach(function (p) {
                const pDay = Number(p.getAttribute("data-panel-day"));
                if (pDay === targetDay) {
                  p.classList.remove("hidden", "opacity-0");
                } else {
                  p.classList.add("hidden", "opacity-0");
                }
              });
            }
          } catch {}
        })();
      </script>
    )
  }

  <!-- Main Borderless Ethereal Canvas Frame -->
  <div class="hero-widget-card relative flex flex-col w-full h-90 sm:h-95 rounded-3xl text-foreground transition-all duration-500">
    <!-- Top Ethereal Floating Header (Seamless, floating badges) -->
    <div class="flex items-center justify-between px-2 pt-2 pb-1 select-none z-10">
      <!-- Active Day Floating Pill -->
      <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-accent/8 border border-accent/20 backdrop-blur-md shadow-2xs">
        <span class="size-2 rounded-full bg-accent animate-pulse shadow-sm shadow-accent/50"></span>
        <span id="hero-widget-day-label" class="font-firacode text-[11px] font-bold text-foreground/90 tracking-tight">
          {DAY_NAMES_SSR[serverDay] || t("heroWidget.badgeToday")}
        </span>
      </div>

      <!-- Explorer Lock / Shuffle Button -->
      <div class="flex items-center gap-1.5">
        <button
          id="hero-explorer-btn"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/12 border border-accent/25 text-[11px] font-bold text-accent hover:bg-accent hover:text-background transition-all duration-200 cursor-pointer shadow-xs active:scale-95 backdrop-blur-md"
          data-locked="true"
        >
          <span id="hero-explorer-icon">🔒</span>
          <span id="hero-explorer-text">{t("heroWidget.explorerLocked")}</span>
        </button>
      </div>
    </div>

    <!-- Widgets Panels Container -->
    <div class="relative flex-1 w-full">
      <!-- 1: Monday (Bento Dev Deck) -->
      <div class:list={["widget-panel absolute inset-0 transition-opacity duration-300", 1 !== serverDay && "hidden opacity-0"]} data-panel-day="1">
        <WidgetBento locale={locale} />
      </div>

      <!-- 2: Tuesday (Live Code Sandbox) -->
      <div class:list={["widget-panel absolute inset-0 transition-opacity duration-300", 2 !== serverDay && "hidden opacity-0"]} data-panel-day="2">
        <WidgetCodeSandbox locale={locale} />
      </div>

      <!-- 3: Wednesday (Quantum Physics & Gravity Lab) -->
      <div class:list={["widget-panel absolute inset-0 transition-opacity duration-300", 3 !== serverDay && "hidden opacity-0"]} data-panel-day="3">
        <WidgetPhysicsLab locale={locale} />
      </div>

      <!-- 4: Thursday (Game of Life) -->
      <div class:list={["widget-panel absolute inset-0 transition-opacity duration-300", 4 !== serverDay && "hidden opacity-0"]} data-panel-day="4">
        <WidgetGameOfLife locale={locale} />
      </div>

      <!-- 5: Friday (3D Spotlight Card) -->
      <div class:list={["widget-panel absolute inset-0 transition-opacity duration-300", 5 !== serverDay && "hidden opacity-0"]} data-panel-day="5">
        <WidgetSpotlightCard locale={locale} featuredPost={featuredPost} />
      </div>

      <!-- 6: Saturday (Mini Launchpad) -->
      <div class:list={["widget-panel absolute inset-0 transition-opacity duration-300", 6 !== serverDay && "hidden opacity-0"]} data-panel-day="6">
        <WidgetLaunchpad locale={locale} />
      </div>

      <!-- 0: Sunday (Dev Radar) -->
      <div class:list={["widget-panel absolute inset-0 transition-opacity duration-300", 0 !== serverDay && "hidden opacity-0"]} data-panel-day="0">
        <WidgetDevRadar locale={locale} />
      </div>
    </div>
  </div>

  <!-- DEV Toolbar (Rendered in dev mode only) -->
  {import.meta.env.DEV && <WidgetDevToolbar locale={locale} />}

  <!-- Quiz Unlocker Modal -->
  <WidgetQuizModal locale={locale} />
</div>

<style>
  /* Ambient Aurora Backlight (Ultra soft ambient glow) */
  .hero-aurora-glow {
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--accent) 22%, transparent) 0%,
      color-mix(in srgb, var(--accent) 8%, transparent) 45%,
      transparent 70%
    );
    opacity: 0.65;
  }

  /* 100% Translucent Seamless Canvas Frame (Fixed without floating) */
  .hero-widget-card {
    background: transparent;
    border: none;
    outline: none;
    box-shadow: none;
  }
</style>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initHeroDailyWidget() {
    const panels = document.querySelectorAll(".widget-panel");
    const dayLabel = document.getElementById("hero-widget-day-label");
    const explorerBtn = document.getElementById("hero-explorer-btn");
    const explorerIcon = document.getElementById("hero-explorer-icon");
    const explorerText = document.getElementById("hero-explorer-text");

    const isEs = document.documentElement.lang === "es";

    const DAY_NAMES: Record<number, string> = {
      1: isEs ? "Lunes • Bento Deck" : "Monday • Bento Deck",
      2: isEs ? "Martes • Code Sandbox" : "Tuesday • Code Sandbox",
      3: isEs ? "Miércoles • Laboratorio de Física" : "Wednesday • Physics Lab",
      4: isEs ? "Jueves • Game of Life" : "Thursday • Game of Life",
      5: isEs ? "Viernes • Spotlight Card" : "Friday • Spotlight Card",
      6: isEs ? "Sábado • Launchpad" : "Saturday • Launchpad",
      0: isEs ? "Domingo • Dev Radar" : "Sunday • Dev Radar",
    };

    // Determine initial day (current day of week: 0 to 6)
    const today = new Date().getDay();
    let currentDay = today;

    function activatePanel(day: number, notify = true) {
      currentDay = day;
      panels.forEach(panel => {
        const pDay = Number(panel.getAttribute("data-panel-day"));
        if (pDay === day) {
          panel.classList.remove("hidden");
          panel.classList.remove("opacity-0");
          panel.classList.add("active");
        } else {
          panel.classList.add("hidden");
          panel.classList.add("opacity-0");
          panel.classList.remove("active");
        }
      });

      if (dayLabel) {
        dayLabel.textContent = DAY_NAMES[day] || "Daily Widget";
      }

      if (notify) {
        window.dispatchEvent(new CustomEvent("herowidget:change", { detail: { day } }));
      }
    }

    function checkExplorerUnlock() {
      const isUnlocked = localStorage.getItem("hero-explorer-unlocked") === "true";
      if (isUnlocked && explorerBtn && explorerIcon && explorerText) {
        explorerBtn.setAttribute("data-locked", "false");
        explorerIcon.textContent = "🔀";
        explorerText.textContent = "Shuffle";
      }
    }

    // Explorer button click handler
    explorerBtn?.addEventListener("click", () => {
      const isLocked = explorerBtn.getAttribute("data-locked") === "true";
      if (isLocked) {
        soundFx.playTap(1100);
        window.dispatchEvent(new CustomEvent("hero-quiz:open"));
      } else {
        // Shuffle to next day
        soundFx.playPop();
        const nextDay = (currentDay + 1) % 7;
        activatePanel(nextDay, true);
      }
    });

    // Listen for custom change events (from dev toolbar or terminal shell)
    window.addEventListener("herowidget:change", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail && typeof detail.day === "number" && detail.day !== currentDay) {
        activatePanel(detail.day, false);
      }
    });

    // Listen for quiz unlock event
    window.addEventListener("hero-explorer:unlocked", () => {
      checkExplorerUnlock();
    });

    // Initialize with persisted dev day or today's default widget
    const savedDevDay = localStorage.getItem("hero-dev-selected-day");
    const initialDay = savedDevDay !== null ? Number(savedDevDay) : today;
    activatePanel(initialDay, true);
    checkExplorerUnlock();
  }

  initHeroDailyWidget();
  document.addEventListener("astro:page-load", initHeroDailyWidget);
</script>
