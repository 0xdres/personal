---
/**
 * WidgetQuizModal.astro
 *
 * Gamified Dev Quiz Modal to unlock Hero Explorer Mode.
 * Features:
 * - Dynamic randomized question bank: switches to a new question on each modal open or retry.
 * - SoundFx integration for correct / incorrect acoustic feedback.
 * - Confetti and celebratory state upon success.
 * - Persistent unlock state in localStorage ("hero-explorer-unlocked").
 */
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale as any);
---

<div
  id="quiz-modal"
  class="quiz-modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4"
  role="dialog"
  aria-modal="true"
  aria-label={t("quiz.modalTitle")}
>
  <!-- Backdrop -->
  <div class="quiz-backdrop absolute inset-0 bg-background/80 backdrop-blur-md transition-opacity duration-300"></div>

  <!-- Quiz Card -->
  <div class="quiz-card relative z-10 w-full max-w-md rounded-2xl border border-accent/40 bg-background/95 p-5 sm:p-6 shadow-2xl backdrop-blur-xl transition-all duration-300">
    <!-- Header -->
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-border/30">
      <div class="flex items-center gap-2">
        <span class="text-xl">🧩</span>
        <h3 class="text-base font-bold text-foreground">{t("quiz.modalTitle")}</h3>
      </div>
      <button id="quiz-close-btn" type="button" class="p-1 rounded-md text-foreground/50 hover:text-foreground hover:bg-muted/30 cursor-pointer" aria-label="Close quiz">✕</button>
    </div>

    <!-- Description -->
    <p class="text-xs text-foreground/75 mb-4 leading-relaxed">
      {t("quiz.modalDesc")}
    </p>

    <!-- Quiz Question Box -->
    <div id="quiz-question-container" class="space-y-3">
      <div class="p-3 rounded-xl border border-border/40 bg-muted/20 text-xs font-semibold text-foreground font-firacode flex items-start gap-2">
        <span class="text-accent shrink-0 font-bold">Q:</span>
        <span id="quiz-question-text" class="leading-relaxed">...</span>
      </div>

      <!-- Options -->
      <div id="quiz-options-container" class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <button type="button" class="quiz-option-btn p-2.5 rounded-lg border border-border/30 bg-muted/10 hover:border-accent/50 hover:bg-accent/10 text-xs font-firacode font-medium text-foreground transition-all duration-150 cursor-pointer text-left active:scale-95" data-option-idx="0">
          Option A
        </button>
        <button type="button" class="quiz-option-btn p-2.5 rounded-lg border border-border/30 bg-muted/10 hover:border-accent/50 hover:bg-accent/10 text-xs font-firacode font-medium text-foreground transition-all duration-150 cursor-pointer text-left active:scale-95" data-option-idx="1">
          Option B
        </button>
        <button type="button" class="quiz-option-btn p-2.5 rounded-lg border border-border/30 bg-muted/10 hover:border-accent/50 hover:bg-accent/10 text-xs font-firacode font-medium text-foreground transition-all duration-150 cursor-pointer text-left active:scale-95" data-option-idx="2">
          Option C
        </button>
        <button type="button" class="quiz-option-btn p-2.5 rounded-lg border border-border/30 bg-muted/10 hover:border-accent/50 hover:bg-accent/10 text-xs font-firacode font-medium text-foreground transition-all duration-150 cursor-pointer text-left active:scale-95" data-option-idx="3">
          Option D
        </button>
      </div>

      <!-- Feedback / Retry Banner -->
      <div id="quiz-error-box" class="hidden flex flex-col items-center gap-2 mt-2">
        <span class="text-xs text-red-500 font-semibold">{t("quiz.errorMsg")}</span>
        <button
          id="quiz-retry-btn"
          type="button"
          class="px-3 py-1 rounded-md bg-muted/20 border border-border/40 text-xs font-semibold text-foreground hover:border-accent/50 cursor-pointer"
        >
          🔄 {t("quiz.tryAgain")}
        </button>
      </div>
    </div>

    <!-- Success State View -->
    <div id="quiz-success-container" class="hidden text-center py-4 space-y-3">
      <div class="text-4xl animate-bounce">🎉🔓</div>
      <h4 class="text-lg font-bold text-accent">{t("quiz.successTitle")}</h4>
      <p class="text-xs text-foreground/80 max-w-xs mx-auto leading-relaxed">
        {t("quiz.successDesc")}
      </p>
      <button
        id="quiz-finish-btn"
        type="button"
        class="px-5 py-2 rounded-lg bg-accent text-background font-bold text-xs hover:brightness-110 transition-all duration-200 cursor-pointer shadow-md shadow-accent/20"
      >
        {t("quiz.letsExplore")}
      </button>
    </div>
  </div>
</div>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initQuizModal() {
    const modal = document.getElementById("quiz-modal");
    const closeBtn = document.getElementById("quiz-close-btn");
    const qContainer = document.getElementById("quiz-question-container");
    const sContainer = document.getElementById("quiz-success-container");
    const errorBox = document.getElementById("quiz-error-box");
    const retryBtn = document.getElementById("quiz-retry-btn");
    const finishBtn = document.getElementById("quiz-finish-btn");
    const qText = document.getElementById("quiz-question-text");
    const options = document.querySelectorAll(".quiz-option-btn");

    const isEs = document.documentElement.lang === "es";

    // Curated Pool of Developer Riddles
    const QUESTIONS_POOL = isEs ? [
      {
        q: "¿Qué método de array en JavaScript crea uno nuevo sin mutar el original?",
        options: [".map()", ".splice()", ".push()", ".reverse()"],
        correct: 0,
      },
      {
        q: "En CSS, ¿cuál es el valor por defecto de la propiedad 'position'?",
        options: ["relative", "static", "absolute", "fixed"],
        correct: 1,
      },
      {
        q: "¿A qué evalúa '0.1 + 0.2 === 0.3' en JavaScript debido a IEEE 754?",
        options: ["true", "undefined", "false", "NaN"],
        correct: 2,
      },
      {
        q: "¿Cuál es el resultado de 'typeof null' en JavaScript?",
        options: ["'null'", "'undefined'", "'boolean'", "'object'"],
        correct: 3,
      },
      {
        q: "¿Cuál es la filosofía de arquitectura de componentes por defecto en Astro?",
        options: ["Zero JS Islands (0 KB)", "Full Client Hydration", "Single Page React App", "Flash on Load"],
        correct: 0,
      },
      {
        q: "¿Qué comando de Git deshaz el 'stage' de archivos sin perder cambios?",
        options: ["git restore --staged", "git push -f", "git rm -rf", "git drop"],
        correct: 0,
      },
    ] : [
      {
        q: "Which JavaScript array method creates a new array without mutating the original?",
        options: [".map()", ".splice()", ".push()", ".reverse()"],
        correct: 0,
      },
      {
        q: "In CSS, what is the default value of the 'position' property?",
        options: ["relative", "static", "absolute", "fixed"],
        correct: 1,
      },
      {
        q: "What does '0.1 + 0.2 === 0.3' evaluate to in JavaScript due to IEEE 754 precision?",
        options: ["true", "undefined", "false", "NaN"],
        correct: 2,
      },
      {
        q: "What is the return value of 'typeof null' in JavaScript?",
        options: ["'null'", "'undefined'", "'boolean'", "'object'"],
        correct: 3,
      },
      {
        q: "What is the core component architecture philosophy of Astro by default?",
        options: ["Zero JS Islands (0 KB)", "Full Client Hydration", "Single Page React App", "Flash on Load"],
        correct: 0,
      },
      {
        q: "Which Git command unstages files without discarding working tree changes?",
        options: ["git restore --staged", "git push -f", "git rm -rf", "git drop"],
        correct: 0,
      },
    ];

    let currentQuestionIdx = -1;
    let activeCorrectIdx = 0;

    function pickRandomQuestion() {
      let nextIdx = Math.floor(Math.random() * QUESTIONS_POOL.length);
      if (nextIdx === currentQuestionIdx && QUESTIONS_POOL.length > 1) {
        nextIdx = (nextIdx + 1) % QUESTIONS_POOL.length;
      }
      currentQuestionIdx = nextIdx;
      const current = QUESTIONS_POOL[currentQuestionIdx];
      if (!current) return;

      if (qText) qText.textContent = current.q;
      activeCorrectIdx = current.correct;

      options.forEach((btn, idx) => {
        btn.textContent = current.options[idx] || "";
        btn.classList.remove("border-red-500", "bg-red-500/10", "border-emerald-500", "bg-emerald-500/10");
      });

      errorBox?.classList.add("hidden");
    }

    function openModal() {
      qContainer?.classList.remove("hidden");
      sContainer?.classList.add("hidden");
      errorBox?.classList.add("hidden");
      pickRandomQuestion();
      modal?.classList.remove("hidden");
    }

    function closeModal() {
      modal?.classList.add("hidden");
    }

    closeBtn?.addEventListener("click", closeModal);
    modal?.querySelector(".quiz-backdrop")?.addEventListener("click", closeModal);

    // Answer click handler
    options.forEach(btn => {
      btn.addEventListener("click", () => {
        const optionIdx = Number(btn.getAttribute("data-option-idx") || "0");
        if (optionIdx === activeCorrectIdx) {
          // Correct!
          soundFx.playQuizSuccess();
          localStorage.setItem("hero-explorer-unlocked", "true");
          window.dispatchEvent(new CustomEvent("hero-explorer:unlocked"));

          qContainer?.classList.add("hidden");
          errorBox?.classList.add("hidden");
          sContainer?.classList.remove("hidden");
        } else {
          // Incorrect!
          soundFx.playQuizError();
          errorBox?.classList.remove("hidden");
          btn.classList.add("border-red-500", "bg-red-500/10");
        }
      });
    });

    retryBtn?.addEventListener("click", () => {
      soundFx.playTap(1100);
      pickRandomQuestion();
    });

    finishBtn?.addEventListener("click", () => {
      soundFx.playTap();
      closeModal();
    });

    // Close on Escape key
    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });

    // Expose open function to triggers
    window.addEventListener("hero-quiz:open", openModal);
  }

  initQuizModal();
  document.addEventListener("astro:page-load", initQuizModal);
</script>
