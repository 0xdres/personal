---
/**
 * WidgetDevToolbar.astro
 *
 * Developer Quick-Switch Toolbar (rendered exclusively when import.meta.env.DEV is true).
 * Features:
 * - Persistent selected day via localStorage ("hero-dev-selected-day").
 * - Clicking the 'DEV' label button resets to the current default day of the week.
 * - Floating glass dock positioned at the bottom right.
 */
interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;

const DAYS = [
  { day: 1, label: locale === "es" ? "Lun" : "Mon", name: "Bento" },
  { day: 2, label: locale === "es" ? "Mar" : "Tue", name: "Code" },
  { day: 3, label: locale === "es" ? "Mié" : "Wed", name: "Audio" },
  { day: 4, label: locale === "es" ? "Jue" : "Thu", name: "Life" },
  { day: 5, label: locale === "es" ? "Vie" : "Fri", name: "Spotlight" },
  { day: 6, label: locale === "es" ? "Sáb" : "Sat", name: "Launchpad" },
  { day: 0, label: locale === "es" ? "Dom" : "Sun", name: "Radar" },
];
---

<div id="dev-toolbar-dock" class="fixed bottom-4 right-4 z-40 flex items-center gap-1.5 p-1.5 rounded-full border border-amber-500/50 bg-background/90 text-foreground shadow-2xl backdrop-blur-xl text-[11px] font-firacode select-none transition-all duration-300">
  <!-- Dev Icon & Reset Label -->
  <button
    id="dev-toolbar-reset-btn"
    type="button"
    class="flex items-center gap-1 px-2.5 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-500 font-bold hover:bg-amber-500/25 transition-all duration-150 cursor-pointer active:scale-95"
    title="Click to reset to today's default hero widget"
  >
    <span>🛠️</span>
    <span class="text-[10px] uppercase font-bold tracking-wider">DEV</span>
  </button>

  <!-- Day Switcher Buttons Row -->
  <div id="dev-toolbar-buttons" class="flex items-center gap-1 pr-1 transition-all duration-200">
    {
      DAYS.map(d => (
        <button
          type="button"
          class="dev-day-btn px-2 py-0.5 rounded-full bg-muted/20 border border-border/40 hover:border-amber-500 hover:text-amber-500 font-bold transition-all duration-150 cursor-pointer active:scale-95 text-[10px]"
          data-target-day={d.day}
          title={`Switch to ${d.name} (${d.label})`}
        >
          {d.label}
        </button>
      ))
    }
  </div>
</div>

<style>
  #dev-toolbar-dock {
    box-shadow:
      0 10px 30px -5px rgba(0, 0, 0, 0.3),
      0 0 15px -3px rgba(245, 158, 11, 0.25);
  }
  .dev-day-btn.active {
    background: #f59e0b !important;
    color: #000000 !important;
    border-color: #f59e0b !important;
  }
</style>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initDevToolbar() {
    const buttons = document.querySelectorAll(".dev-day-btn");
    const resetBtn = document.getElementById("dev-toolbar-reset-btn");

    function highlightDay(day: number) {
      buttons.forEach(btn => {
        const btnDay = Number(btn.getAttribute("data-target-day"));
        if (btnDay === day) {
          btn.classList.add("active");
        } else {
          btn.classList.remove("active");
        }
      });
    }

    // Initialize highlight based on stored override or today's day
    const savedDay = localStorage.getItem("hero-dev-selected-day");
    const initialDay = savedDay !== null ? Number(savedDay) : new Date().getDay();
    highlightDay(initialDay);

    buttons.forEach(btn => {
      btn.addEventListener("click", () => {
        const targetDay = Number(btn.getAttribute("data-target-day") || "1");
        soundFx.playTap(1400);

        // Store selected day persistently across page refreshes
        localStorage.setItem("hero-dev-selected-day", String(targetDay));
        highlightDay(targetDay);

        window.dispatchEvent(
          new CustomEvent("herowidget:change", {
            detail: { day: targetDay },
          })
        );
      });
    });

    // Reset button click: restore today's default widget and remove persistence
    resetBtn?.addEventListener("click", () => {
      soundFx.playPop();
      localStorage.removeItem("hero-dev-selected-day");
      const today = new Date().getDay();
      highlightDay(today);

      window.dispatchEvent(
        new CustomEvent("herowidget:change", {
          detail: { day: today },
        })
      );
    });
  }

  initDevToolbar();
  document.addEventListener("astro:page-load", initDevToolbar);
</script>
