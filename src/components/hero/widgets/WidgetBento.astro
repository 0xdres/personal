---
/**
 * WidgetBento.astro
 *
 * Monday's Hero Widget: Interactive Bento Dev Deck.
 * Features:
 * - Real-time 24-hour clock formatted to Guatemala timezone (America/Guatemala).
 * - Live status badge with glowing green pulse.
 * - Interactive Tech Matrix with full-width dynamic inspector (no ellipsis clipping, multi-line support).
 * - Compact 2-row GitHub-style activity contribution pulse heatmap (zero overflow).
 * - Fully accessible and responsive.
 */
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale as any);
const isEs = locale === "es";

const TECH_STACK = [
  {
    name: "Astro 5",
    icon: "🚀",
    desc: locale === "es" ? "Framework web ultra-rápido de islas (0 KB JS)" : "Ultra-fast web framework powered by islands",
  },
  {
    name: "TypeScript",
    icon: "🔷",
    desc: locale === "es" ? "Tipado estático seguro y arquitectura limpia" : "Static type safety and clean architecture",
  },
  {
    name: "AI Agents",
    icon: "⚡",
    desc: locale === "es" ? "Flujos autónomos y razonamiento con LLMs" : "Autonomous agentic workflows with LLMs",
  },
  {
    name: "Web Audio",
    icon: "🔊",
    desc: locale === "es" ? "Síntesis sonora nativa en el navegador" : "Native in-browser sound synthesis engine",
  },
  {
    name: "Tailwind",
    icon: "🎨",
    desc: isEs ? "Sistema de diseño y estilos utilitarios modernos" : "Modern utility-first styling and design tokens",
  },
  {
    name: "Pagefind",
    icon: "🔍",
    desc: isEs ? "Búsqueda offline instantánea en el cliente" : "Sub-10ms offline client-side search index",
  },
];

const HEATMAP_DAYS = [1, 3, 2, 4, 5, 2, 4, 3, 5, 4, 5, 5, 4, 5];
---

<div id="bento-widget-root" class="bento-widget flex flex-col justify-between p-3.5 sm:p-4 h-full select-none" role="region" aria-label="Bento Dev Deck">
  <!-- Top Row: 24h Live Clock & Status Badge -->
  <div class="grid grid-cols-2 gap-2.5">
    <!-- 24h Live Timezone Card -->
    <div class="bento-card flex items-center justify-between px-3 py-2 sm:py-2.5 rounded-xl border border-border/40 bg-background/50 backdrop-blur-md min-w-0">
      <div class="flex items-center gap-2 min-w-0">
        <div class="flex size-6.5 shrink-0 items-center justify-center rounded-lg bg-accent/10 border border-accent/20 text-accent text-xs">
          🕒
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-[9.5px] uppercase font-bold tracking-wider opacity-50 truncate">
            {t("heroWidget.bento.timezone")}
          </span>
          <span id="bento-live-clock" class="font-firacode text-xs sm:text-sm font-bold text-foreground tracking-tight" aria-live="off">
            --:--:--
          </span>
        </div>
      </div>
      <span class="text-[9px] font-firacode px-1.5 py-0.5 rounded bg-muted/30 border border-border/30 opacity-60 shrink-0">
        24H
      </span>
    </div>

    <!-- Status Pulse Card -->
    <div class="bento-card flex items-center gap-2 px-3 py-2 sm:py-2.5 rounded-xl border border-border/40 bg-background/50 backdrop-blur-md min-w-0">
      <span class="relative flex h-2.5 w-2.5 shrink-0">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
      </span>
      <div class="flex flex-col min-w-0 overflow-hidden">
        <span class="text-[9.5px] uppercase font-bold tracking-wider opacity-50">Status</span>
        <span class="text-xs font-semibold text-foreground truncate" title={t("heroWidget.bento.status")}>
          {t("heroWidget.bento.status")}
        </span>
      </div>
    </div>
  </div>

  <!-- Middle Row: 14-Day Contribution Heatmap Grid -->
  <div class="bento-card my-2 p-2.5 rounded-xl border border-border/40 bg-background/50 backdrop-blur-md">
    <div class="flex items-center justify-between mb-1.5">
      <div class="flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-emerald-400"></span>
        <span class="text-[10px] font-firacode text-foreground/75 font-semibold">
          {t("heroWidget.bento.recentActivity")}
        </span>
      </div>
      <span class="text-[9.5px] font-firacode text-foreground/50">
        14 Days
      </span>
    </div>

    <!-- 14-Day Heatmap Grid -->
    <div class="grid grid-cols-7 gap-1 w-full max-w-full overflow-hidden">
      {
        HEATMAP_DAYS.map((lvl, idx) => (
          <div
            class:list={[
              "aspect-square w-full rounded-xs transition-transform duration-150 hover:scale-115 cursor-pointer",
              lvl === 0 && "bg-muted/30 border border-border/20",
              lvl === 1 && "bg-emerald-500/25 border border-emerald-500/35",
              lvl === 2 && "bg-emerald-500/50 border border-emerald-500/60",
              lvl === 3 && "bg-emerald-500/80 border border-emerald-500/90",
              lvl === 4 && "bg-emerald-400 border border-emerald-300 shadow-xs",
            ]}
            title={`Day -${14 - idx}: Level ${lvl} Activity`}
          />
        ))
      }
    </div>
  </div>

  <!-- Bottom Row: Dynamic Live Tech Matrix Bar -->
  <div class="bento-card p-2 rounded-xl border border-border/40 bg-background/50 backdrop-blur-md flex flex-col gap-1.5">
    <div id="bento-inspector-bar" class="w-full flex items-center gap-2 px-1 min-h-[30px] rounded-lg bg-muted/20 border border-border/30">
      <span id="bento-inspector-icon" class="text-sm shrink-0">⚡</span>
      <p id="bento-inspector-text" class="text-[10px] sm:text-[10.5px] text-foreground/90 font-firacode leading-tight line-clamp-2" aria-live="polite">
        <strong class="text-accent">Tech Matrix</strong>: {isEs ? "Pasa el cursor sobre un módulo" : "Hover a module to inspect"}
      </p>
    </div>

    <div class="flex items-center gap-1 overflow-x-auto min-w-0 scrollbar-none py-0.5" role="list">
      {
        TECH_STACK.map(tech => (
          <button
            type="button"
            class="bento-tech-pill px-2 py-0.5 rounded-md bg-muted/30 border border-border/40 text-[10px] font-medium text-foreground/80 hover:text-accent hover:border-accent/40 hover:bg-accent/10 transition-all duration-150 cursor-pointer shrink-0"
            data-tech-name={tech.name}
            data-tech-desc={tech.desc}
            data-tech-icon={tech.icon}
            title={tech.name}
          >
            <span>{tech.name}</span>
          </button>
        ))
      }
    </div>
  </div>
</div>

<style>
  @keyframes bentoPulse {
    0% { transform: scale(1); opacity: 0.85; }
    100% { transform: scale(1.06); opacity: 1; }
  }

  .bento-card {
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-card:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    box-shadow: 0 4px 15px -4px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .bento-tech-pill:active {
    transform: scale(0.96);
  }
</style>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initBentoWidget() {
    const rootEl = document.getElementById("bento-widget-root");
    const clockEl = document.getElementById("bento-live-clock");
    const inspectorIcon = document.getElementById("bento-inspector-icon");
    const inspectorText = document.getElementById("bento-inspector-text");
    const techButtons = document.querySelectorAll("[data-tech-name]");

    if (!rootEl) return;

    const isEs = document.documentElement.lang === "es";
    const defaultText = isEs ? `<strong class="text-accent">Tech Matrix</strong>: Pasa el cursor sobre un módulo` : `<strong class="text-accent">Tech Matrix</strong>: Hover a module to inspect`;

    let clockInterval: number | null = null;
    let isInViewport = true;
    let isPanelActive = true;

    function updateClock() {
      if (!clockEl) return;
      try {
        const now = new Date();
        const formatter = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/Guatemala",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: false,
          hourCycle: "h23",
        });
        clockEl.textContent = formatter.format(now);
      } catch (_) {
        const now = new Date();
        clockEl.textContent = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}:${String(now.getSeconds()).padStart(2, "0")}`;
      }
    }

    function evaluateExecution() {
      const shouldRun = isInViewport && isPanelActive && document.visibilityState === "visible";
      if (shouldRun && !clockInterval) {
        updateClock();
        clockInterval = window.setInterval(updateClock, 1000);
      } else if (!shouldRun && clockInterval) {
        clearInterval(clockInterval);
        clockInterval = null;
      }
    }

    // 1. Intersection Observer: Pauses clock when scrolled away
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          isInViewport = entry.isIntersecting;
          evaluateExecution();
        });
      },
      { threshold: 0.05 }
    );
    observer.observe(rootEl);

    // 2. Page Visibility: Pauses clock when tab is in background
    document.addEventListener("visibilitychange", evaluateExecution);

    // 3. Panel Active Guard: Listens to hero widget changes (Day 1 = Monday)
    window.addEventListener("herowidget:change", (e: Event) => {
      const day = (e as CustomEvent).detail?.day;
      isPanelActive = day === 1;
      evaluateExecution();
    });

    const panel = rootEl.closest(".widget-panel");
    if (panel) isPanelActive = !panel.classList.contains("hidden");
    evaluateExecution();

    // Interactive Tech Inspector
    techButtons.forEach(btn => {
      const name = btn.getAttribute("data-tech-name") || "";
      const desc = btn.getAttribute("data-tech-desc") || "";
      const icon = btn.getAttribute("data-tech-icon") || "⚡";

      const showInspector = () => {
        if (inspectorIcon) inspectorIcon.textContent = icon;
        if (inspectorText) inspectorText.innerHTML = `<strong class="text-accent">${name}</strong>: ${desc}`;
      };

      const resetInspector = () => {
        if (inspectorIcon) inspectorIcon.textContent = "⚡";
        if (inspectorText) inspectorText.innerHTML = defaultText;
      };

      btn.addEventListener("mouseenter", showInspector);
      btn.addEventListener("focus", showInspector);
      btn.addEventListener("mouseleave", resetInspector);
      btn.addEventListener("blur", resetInspector);

      btn.addEventListener("click", () => {
        soundFx.playTap(1200);
        showInspector();
      });
    });

    document.addEventListener("astro:before-swap", () => {
      observer.disconnect();
      document.removeEventListener("visibilitychange", evaluateExecution);
      if (clockInterval) clearInterval(clockInterval);
    }, { once: true });
  }

  initBentoWidget();
  document.addEventListener("astro:page-load", initBentoWidget);
</script>
