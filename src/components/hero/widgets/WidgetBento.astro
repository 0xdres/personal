---
/**
 * WidgetBento.astro
 *
 * Monday's Hero Widget: Interactive Bento Dev Deck.
 * Features:
 * - Real-time 24-hour clock formatted to Guatemala timezone (America/Guatemala).
 * - Live status badge with glowing green pulse.
 * - Interactive Tech Matrix with full-width dynamic inspector (no ellipsis clipping, multi-line support).
 * - Compact 2-row GitHub-style activity contribution pulse heatmap (zero overflow).
 * - Zero-overhead background pause via IntersectionObserver, document.visibilityState and Panel Active Guard.
 * - Fully accessible and responsive.
 */
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale);
const isEs = locale === "es";

const TECH_STACK = [
  {
    name: "Astro 5",
    icon: "🚀",
    desc: isEs ? "Framework web ultra-rápido de islas (0 KB JS)" : "Ultra-fast web framework powered by islands",
  },
  {
    name: "TypeScript",
    icon: "🔷",
    desc: isEs ? "Tipado estático seguro y arquitectura limpia" : "Static type safety and clean architecture",
  },
  {
    name: "AI Agents",
    icon: "⚡",
    desc: isEs ? "Flujos autónomos y razonamiento con LLMs" : "Autonomous agentic workflows with LLMs",
  },
  {
    name: "Web Audio",
    icon: "🔊",
    desc: isEs ? "Síntesis sonora nativa en el navegador" : "Native in-browser sound synthesis engine",
  },
  {
    name: "Tailwind",
    icon: "🎨",
    desc: isEs ? "Sistema de diseño y estilos utilitarios modernos" : "Modern utility-first styling and design tokens",
  },
  {
    name: "Pagefind",
    icon: "🔍",
    desc: isEs ? "Búsqueda offline instantánea en el cliente" : "Sub-10ms offline client-side search index",
  },
];
---

<div id="bento-widget-root" class="bento-widget flex flex-col justify-between px-3.5 pb-3.5 pt-1 h-full select-none" role="region" aria-label="Bento Dev Deck">
  <!-- Top Row: 24h Live Clock & Status Badge -->
  <div class="grid grid-cols-2 gap-2">
    <!-- 24h Live Timezone Card -->
    <div class="bento-card flex items-center justify-between px-3 py-2 rounded-xl border border-border/15 bg-accent/5 min-w-0">
      <div class="flex items-center gap-2 min-w-0">
        <div class="flex size-6 shrink-0 items-center justify-center rounded-lg bg-accent/10 border border-accent/20 text-accent text-xs">
          🕒
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-[9px] uppercase font-bold tracking-wider opacity-50 truncate">
            {t("heroWidget.bento.timezone")}
          </span>
          <span id="bento-live-clock" class="font-firacode text-xs sm:text-sm font-bold text-foreground tracking-tight" aria-live="off">
            --:--:--
          </span>
        </div>
      </div>
      <span class="text-[9px] font-firacode px-1.5 py-0.5 rounded bg-muted/20 border border-border/20 opacity-60 shrink-0">
        24H
      </span>
    </div>

    <!-- Status Pulse Card -->
    <div class="bento-card flex items-center gap-2 px-3 py-2 rounded-xl border border-border/15 bg-accent/5 min-w-0">
      <span class="relative flex h-2.5 w-2.5 shrink-0">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
      </span>
      <div class="flex flex-col min-w-0 overflow-hidden">
        <span class="text-[9px] uppercase font-bold tracking-wider opacity-50">Status</span>
        <span class="text-xs font-semibold text-foreground truncate" title={t("heroWidget.bento.status")}>
          {t("heroWidget.bento.status")}
        </span>
      </div>
    </div>
  </div>

  <!-- Middle Row: Interactive Tech Stack Matrix with Full-Width Inspector -->
  <div class="bento-card flex flex-col p-2.5 rounded-xl border border-border/15 bg-accent/5">
    <!-- Dynamic Tech Inspector Line (Full width, zero truncation ellipsis) -->
    <div class="flex items-center gap-1.5 mb-1.5 pb-1 border-b border-border/15 min-h-6">
      <span id="bento-inspector-icon" class="text-xs shrink-0">⚡</span>
      <span id="bento-inspector-text" class="text-[10px] sm:text-[10.5px] font-medium text-foreground/85 font-firacode leading-tight line-clamp-2">
        <strong class="text-accent">Tech Matrix</strong>: {isEs ? "Pasa el cursor sobre un módulo" : "Hover a module to inspect"}
      </span>
    </div>

    <!-- Tech Pills Grid -->
    <div class="grid grid-cols-3 gap-1.5">
      {
        TECH_STACK.map(tech => (
          <button
            type="button"
            class="bento-tech-pill group relative flex items-center justify-center sm:justify-start gap-1.5 px-2 py-1.5 rounded-lg border border-border/20 bg-muted/10 text-xs font-medium text-foreground/80 hover:border-accent/60 hover:bg-accent/10 hover:text-accent transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
            data-tech-name={tech.name}
            data-tech-desc={tech.desc}
            data-tech-icon={tech.icon}
            aria-label={`${tech.name}: ${tech.desc}`}
          >
            <span class="text-xs transition-transform duration-200 group-hover:scale-125 shrink-0">{tech.icon}</span>
            <span class="font-firacode text-[11px] truncate font-semibold">{tech.name}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Bottom Row: 2-Row GitHub Style Activity Contribution Heatmap (Zero Overflow) -->
  <div class="bento-card flex items-center justify-between px-3 py-2 rounded-xl border border-border/15 bg-accent/5 gap-3">
    <div class="flex flex-col min-w-0">
      <span class="text-[9px] uppercase font-bold tracking-wider opacity-50 truncate">
        {t("heroWidget.bento.recentActivity")}
      </span>
      <span class="text-xs font-semibold text-accent truncate">
        Consistent Weekly Rhythm ⚡
      </span>
    </div>
    <!-- 2-Row x 7-Col GitHub Grid (14 days, perfectly compact, zero overflow) -->
    <div class="grid grid-rows-2 grid-flow-col gap-1 shrink-0" aria-label="Recent activity heatmap">
      {
        [1, 3, 2, 4, 5, 2, 4, 3, 5, 4, 5, 5, 4, 5].map((lvl, i) => (
          <span
            class="size-2.5 rounded-xs transition-all duration-200 hover:scale-135 hover:ring-1 hover:ring-accent cursor-pointer"
            title={`Activity Level ${lvl}/5`}
            style={`
              background-color: ${
                lvl === 1 ? "color-mix(in srgb, var(--accent) 18%, transparent)" :
                lvl === 2 ? "color-mix(in srgb, var(--accent) 38%, transparent)" :
                lvl === 3 ? "color-mix(in srgb, var(--accent) 60%, transparent)" :
                lvl === 4 ? "color-mix(in srgb, var(--accent) 80%, transparent)" :
                "var(--accent)"
              };
              animation: bentoPulse 2.2s ease-in-out infinite alternate;
              animation-delay: ${i * 0.08}s;
            `}
          />
        ))
      }
    </div>
  </div>
</div>

<style>
  @keyframes bentoPulse {
    0% { transform: scale(1); opacity: 0.85; }
    100% { transform: scale(1.06); opacity: 1; }
  }

  .bento-card {
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-card:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    box-shadow: 0 4px 15px -4px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .bento-tech-pill:active {
    transform: scale(0.96);
  }
</style>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initBentoWidget() {
    const rootEl = document.getElementById("bento-widget-root");
    const clockEl = document.getElementById("bento-live-clock");
    const inspectorIcon = document.getElementById("bento-inspector-icon");
    const inspectorText = document.getElementById("bento-inspector-text");
    const techButtons = document.querySelectorAll("[data-tech-name]");

    if (!rootEl) return;

    const isEs = document.documentElement.lang === "es";
    const defaultText = isEs ? `<strong class="text-accent">Tech Matrix</strong>: Pasa el cursor sobre un módulo` : `<strong class="text-accent">Tech Matrix</strong>: Hover a module to inspect`;

    let clockInterval: number | null = null;
    let isInViewport = true;
    let isPanelActive = true;

    function updateClock() {
      if (!clockEl) return;
      try {
        const now = new Date();
        const formatter = new Intl.DateTimeFormat("en-US", {
          timeZone: "America/Guatemala",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: false,
          hourCycle: "h23",
        });
        clockEl.textContent = formatter.format(now);
      } catch {
        const now = new Date();
        clockEl.textContent = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}:${String(now.getSeconds()).padStart(2, "0")}`;
      }
    }

    function evaluateExecution() {
      if (isPanelActive && !isInViewport && rootEl) {
        const rect = rootEl.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < window.innerHeight) {
          isInViewport = true;
        }
      }
      const shouldRun = isInViewport && isPanelActive && document.visibilityState === "visible";
      if (shouldRun && !clockInterval) {
        updateClock();
        clockInterval = window.setInterval(updateClock, 1000);
      } else if (!shouldRun && clockInterval) {
        clearInterval(clockInterval);
        clockInterval = null;
      }
    }

    // 1. Intersection Observer: Pauses clock when scrolled away
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          isInViewport = entry.isIntersecting;
          evaluateExecution();
        });
      },
      { threshold: 0.05 }
    );
    observer.observe(rootEl);

    // 2. Page Visibility: Pauses clock when tab is in background
    document.addEventListener("visibilitychange", evaluateExecution);

    // 3. Panel Active Guard: Listens to hero widget changes (Day 1 = Monday)
    window.addEventListener("herowidget:change", (e: Event) => {
      const day = (e as CustomEvent).detail?.day;
      isPanelActive = day === 1;
      evaluateExecution();
    });

    const panel = rootEl.closest(".widget-panel");
    if (panel) isPanelActive = !panel.classList.contains("hidden");
    evaluateExecution();

    // Interactive Tech Inspector
    techButtons.forEach(btn => {
      const name = btn.getAttribute("data-tech-name") || "";
      const desc = btn.getAttribute("data-tech-desc") || "";
      const icon = btn.getAttribute("data-tech-icon") || "⚡";

      const showInspector = () => {
        if (inspectorIcon) inspectorIcon.textContent = icon;
        if (inspectorText) inspectorText.innerHTML = `<strong class="text-accent">${name}</strong>: ${desc}`;
      };

      const resetInspector = () => {
        if (inspectorIcon) inspectorIcon.textContent = "⚡";
        if (inspectorText) inspectorText.innerHTML = defaultText;
      };

      btn.addEventListener("mouseenter", showInspector);
      btn.addEventListener("focus", showInspector);
      btn.addEventListener("mouseleave", resetInspector);
      btn.addEventListener("blur", resetInspector);

      btn.addEventListener("click", () => {
        soundFx.playTap(1200);
        showInspector();
      });
    });

    document.addEventListener("astro:before-swap", () => {
      observer.disconnect();
      document.removeEventListener("visibilitychange", evaluateExecution);
      if (clockInterval) clearInterval(clockInterval);
    }, { once: true });
  }

  initBentoWidget();
  document.addEventListener("astro:page-load", initBentoWidget);
</script>
