---
/**
 * WidgetCodeSandbox.astro
 *
 * Tuesday's Hero Widget: Interactive Live Code Sandbox.
 * Features:
 * - 3 interactive code snippets with deep real-time browser dynamics:
 *   1. synth.ts: Real-time scale synthesis (C - D - E - F - G) with fast inline colored text stream.
 *   2. particles.ts: Kinetic 60 FPS Particle Physics Burst + Interactive cursor mouse trail.
 *   3. shake.ts: Juicy JELLY wobble physics animation on the widget container.
 * - 100% Bilingual localization (EN/ES) for comments, titles, and real-time logs.
 * - Clean modern header (macOS traffic lights removed for maximum tab space).
 * - IDE-grade syntax highlighting with tokenized keywords, types, strings, numbers & comments.
 * - Line numbers gutter.
 */
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale);
const isEs = locale === "es";

const SNIPPETS = [
  {
    id: "synth",
    filename: "synth.ts",
    icon: "🎵",
    codeHtml: `<span class="syn-comment">${isEs ? "// 🎵 Síntesis Web Audio nativa en el navegador" : "// 🎵 Fast in-browser Web Audio Scale Synthesis"}</span>
<span class="syn-keyword">function</span> <span class="syn-fn">playScale</span>(notes = [<span class="syn-str">"C"</span>, <span class="syn-str">"D"</span>, <span class="syn-str">"E"</span>, <span class="syn-str">"F"</span>, <span class="syn-str">"G"</span>]) {
  <span class="syn-keyword">const</span> ctx = <span class="syn-keyword">new</span> <span class="syn-type">AudioContext</span>();
  notes.<span class="syn-fn">forEach</span>((note, i) => {
    <span class="syn-keyword">const</span> osc = ctx.<span class="syn-fn">createOscillator</span>();
    <span class="syn-keyword">const</span> gain = ctx.<span class="syn-fn">createGain</span>();
    osc.<span class="syn-prop">frequency</span>.<span class="syn-fn">setValueAtTime</span>(
      <span class="syn-fn">getFreq</span>(note), ctx.<span class="syn-prop">currentTime</span> + i * <span class="syn-num">0.13</span>
    );
    osc.<span class="syn-fn">connect</span>(gain).<span class="syn-fn">connect</span>(ctx.<span class="syn-prop">destination</span>);
    osc.<span class="syn-fn">start</span>(ctx.<span class="syn-prop">currentTime</span> + i * <span class="syn-num">0.13</span>);
    osc.<span class="syn-fn">stop</span>(ctx.<span class="syn-prop">currentTime</span> + (i + <span class="syn-num">1</span>) * <span class="syn-num">0.13</span>);
  });
}`,
    outputTitle: isEs ? "Escala Musical (Web Audio)" : "Synthesized Scale (Web Audio)",
  },
  {
    id: "particles",
    filename: "particles.ts",
    icon: "🎆",
    codeHtml: `<span class="syn-comment">${isEs ? "// 🎆 Explosión física de partículas a 60 FPS" : "// 🎆 60 FPS Particle Physics Burst"}</span>
<span class="syn-keyword">function</span> <span class="syn-fn">emitParticles</span>(count = <span class="syn-num">45</span>, origin = { <span class="syn-prop">x</span>: <span class="syn-num">0.5</span>, <span class="syn-prop">y</span>: <span class="syn-num">0.5</span> }) {
  <span class="syn-keyword">const</span> burst = Array.<span class="syn-fn">from</span>({ length: count }, () => ({
    x: origin.<span class="syn-prop">x</span>, y: origin.<span class="syn-prop">y</span>,
    vx: (Math.<span class="syn-fn">random</span>() - <span class="syn-num">0.5</span>) * <span class="syn-num">14</span>,
    vy: (Math.<span class="syn-fn">random</span>() - <span class="syn-num">0.8</span>) * <span class="syn-num">16</span>,
    gravity: <span class="syn-num">0.45</span>,
    hue: Math.<span class="syn-fn">floor</span>(Math.<span class="syn-fn">random</span>() * <span class="syn-num">360</span>)
  }));
  <span class="syn-keyword">return</span> <span class="syn-fn">renderPhysicsLoop</span>(burst);
}`,
    outputTitle: isEs ? "Física de Partículas (Canvas)" : "Particle Physics (Canvas)",
  },
  {
    id: "shake",
    filename: "shake.ts",
    icon: "🧲",
    codeHtml: `<span class="syn-comment">${isEs ? "// 🧲 Física de oscilación elástica gelatina" : "// 🧲 Juicy JELLY Wobble Physics"}</span>
<span class="syn-keyword">function</span> <span class="syn-fn">triggerJellyWobble</span>(element: <span class="syn-type">HTMLElement</span>) {
  element.<span class="syn-prop">classList</span>.<span class="syn-fn">remove</span>(<span class="syn-str">"jelly-active"</span>);
  <span class="syn-fn">void</span> element.<span class="syn-prop">offsetWidth</span>; <span class="syn-comment">// Reflow</span>
  element.<span class="syn-prop">classList</span>.<span class="syn-fn">add</span>(<span class="syn-str">"jelly-active"</span>);

  <span class="syn-keyword">return</span> { <span class="syn-prop">physics</span>: <span class="syn-str">"elastic-squash"</span>, <span class="syn-prop">duration</span>: <span class="syn-str">"650ms"</span> };
}`,
    outputTitle: isEs ? "Física Elástica (Jelly)" : "Jelly Wobble Physics",
  },
];
---

<div id="sandbox-widget-root" class="code-sandbox-widget relative flex flex-col h-full rounded-xl overflow-hidden font-firacode select-none">
  <!-- Interactive Particle Canvas Layer -->
  <canvas id="sandbox-particles-canvas" class="pointer-events-none absolute inset-0 z-30 w-full h-full"></canvas>

  <!-- Code Editor Header Bar (Tabs + Run Button) -->
  <div class="flex items-center justify-between px-3.5 pt-1 pb-1.5 gap-2">
    <!-- Tabs Row (Direct, clean modern design) -->
    <div class="flex items-center gap-1 overflow-x-auto min-w-0 flex-1 scrollbar-none">
      {
        SNIPPETS.map((s, idx) => (
          <button
            type="button"
            class:list={[
              "sandbox-tab px-2.5 py-1 rounded-md text-[10.5px] font-semibold transition-all duration-150 cursor-pointer flex items-center gap-1 shrink-0 border border-transparent text-foreground/60 hover:text-foreground hover:bg-muted/20",
              idx === 0 && "active",
            ]}
            data-snippet-id={s.id}
          >
            <span>{s.icon}</span>
            <span>{s.filename}</span>
          </button>
        ))
      }
    </div>

    <!-- Run Action Button -->
    <button
      id="sandbox-run-btn"
      type="button"
      class="flex items-center gap-1 px-3 py-1 rounded-md bg-accent text-background text-[11px] font-bold hover:brightness-110 transition-all duration-150 cursor-pointer shadow-xs active:scale-95 shrink-0"
      title="Execute code snippet"
    >
      <span>▶</span>
      <span>{t("heroWidget.code.run")}</span>
    </button>
  </div>

  <!-- Code Body with Line Numbers & Syntax Highlighting -->
  <div id="sandbox-editor-body" class="relative flex-1 mx-3 mb-3 p-3 rounded-xl border border-border/15 bg-transparent overflow-hidden text-[11px] sm:text-[11.5px] leading-relaxed flex cursor-crosshair">
    <!-- Line numbers gutter -->
    <div class="select-none pr-3 text-right text-foreground/30 font-firacode text-[10.5px] border-r border-border/30 flex flex-col space-y-0.5 shrink-0">
      <span>1</span>
      <span>2</span>
      <span>3</span>
      <span>4</span>
      <span>5</span>
      <span>6</span>
      <span>7</span>
      <span>8</span>
      <span>9</span>
      <span>10</span>
      <span>11</span>
      <span>12</span>
    </div>

    <!-- Code Snippet Container -->
    <div class="flex-1 pl-3 overflow-x-auto scrollbar-thin">
      <pre id="sandbox-code-display" class="font-firacode whitespace-pre font-medium" set:html={SNIPPETS[0].codeHtml} />
    </div>

    <!-- Execution Output Drawer -->
    <div
      id="sandbox-output-drawer"
      class="hidden absolute inset-x-0 bottom-0 p-3 border-t border-accent/40 bg-background/95 backdrop-blur-xl shadow-2xl transition-all duration-300 z-20 max-h-35 overflow-hidden"
    >
      <div class="flex items-center justify-between text-[10px] uppercase font-bold text-accent mb-1 sticky top-0 bg-background/90 py-0.5">
        <div class="flex items-center gap-1.5">
          <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="sandbox-output-title">{SNIPPETS[0].outputTitle}</span>
        </div>
        <button id="sandbox-close-output" type="button" class="text-foreground/50 hover:text-foreground cursor-pointer px-1">✕</button>
      </div>
      <div id="sandbox-output-logs" class="space-y-1 text-[10.5px] text-foreground/90 font-firacode">
      </div>
    </div>
  </div>
</div>

<style>
  /* Syntax Highlighting Tokens (Dark & Modern Theme) */
  :global(.syn-keyword) {
    color: #f43f5e;
    font-weight: 600;
  }
  :global(.syn-fn) {
    color: #38bdf8;
    font-weight: 600;
  }
  :global(.syn-type) {
    color: #f59e0b;
  }
  :global(.syn-str) {
    color: #10b981;
  }
  :global(.syn-num) {
    color: #a855f7;
  }
  :global(.syn-comment) {
    color: #64748b;
    font-style: italic;
  }
  :global(.syn-prop) {
    color: var(--foreground);
    opacity: 0.9;
  }

  /* Light Theme Overrides */
  :global([data-theme="light"] .syn-keyword) {
    color: #e11d48;
  }
  :global([data-theme="light"] .syn-fn) {
    color: #0284c7;
  }
  :global([data-theme="light"] .syn-type) {
    color: #d97706;
  }
  :global([data-theme="light"] .syn-str) {
    color: #059669;
  }
  :global([data-theme="light"] .syn-num) {
    color: #7c3aed;
  }
  :global([data-theme="light"] .syn-comment) {
    color: #64748b;
  }

  .sandbox-tab.active {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    box-shadow: 0 1px 3px 0 color-mix(in srgb, var(--accent) 15%, transparent);
  }

  /* Jelly Wobble Animation */
  @keyframes jellyWobble {
    0% { transform: scale3d(1, 1, 1); }
    25% { transform: scale3d(1.08, 0.92, 1); }
    40% { transform: scale3d(0.92, 1.08, 1); }
    55% { transform: scale3d(1.05, 0.95, 1); }
    70% { transform: scale3d(0.97, 1.03, 1); }
    85% { transform: scale3d(1.01, 0.99, 1); }
    100% { transform: scale3d(1, 1, 1); }
  }

  :global(.jelly-active) {
    animation: jellyWobble 0.65s cubic-bezier(0.25, 1, 0.5, 1) !important;
    transform-origin: center center !important;
  }
</style>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initCodeSandbox() {
    const rootWidget = document.getElementById("sandbox-widget-root");
    const editorBody = document.getElementById("sandbox-editor-body");
    const particleCanvas = document.getElementById("sandbox-particles-canvas") as HTMLCanvasElement | null;
    const tabs = document.querySelectorAll(".sandbox-tab");
    const codeDisplay = document.getElementById("sandbox-code-display");
    const runBtn = document.getElementById("sandbox-run-btn");
    const outputDrawer = document.getElementById("sandbox-output-drawer");
    const outputTitle = document.getElementById("sandbox-output-title");
    const outputLogs = document.getElementById("sandbox-output-logs");
    const closeOutput = document.getElementById("sandbox-close-output");

    const isEs = document.documentElement.lang === "es" || window.location.pathname.startsWith("/es");

    const SNIPPETS_DATA: Record<string, { codeHtml: string; title: string }> = {
      synth: {
        codeHtml: `<span class="syn-comment">${isEs ? "// 🎵 Síntesis Web Audio nativa en el navegador" : "// 🎵 Fast in-browser Web Audio Scale Synthesis"}</span>
<span class="syn-keyword">function</span> <span class="syn-fn">playScale</span>(notes = [<span class="syn-str">"C"</span>, <span class="syn-str">"D"</span>, <span class="syn-str">"E"</span>, <span class="syn-str">"F"</span>, <span class="syn-str">"G"</span>]) {
  <span class="syn-keyword">const</span> ctx = <span class="syn-keyword">new</span> <span class="syn-type">AudioContext</span>();
  notes.<span class="syn-fn">forEach</span>((note, i) => {
    <span class="syn-keyword">const</span> osc = ctx.<span class="syn-fn">createOscillator</span>();
    <span class="syn-keyword">const</span> gain = ctx.<span class="syn-fn">createGain</span>();
    osc.<span class="syn-prop">frequency</span>.<span class="syn-fn">setValueAtTime</span>(
      <span class="syn-fn">getFreq</span>(note), ctx.<span class="syn-prop">currentTime</span> + i * <span class="syn-num">0.13</span>
    );
    osc.<span class="syn-fn">connect</span>(gain).<span class="syn-fn">connect</span>(ctx.<span class="syn-prop">destination</span>);
    osc.<span class="syn-fn">start</span>(ctx.<span class="syn-prop">currentTime</span> + i * <span class="syn-num">0.13</span>);
    osc.<span class="syn-fn">stop</span>(ctx.<span class="syn-prop">currentTime</span> + (i + <span class="syn-num">1</span>) * <span class="syn-num">0.13</span>);
  });
}`,
        title: isEs ? "Escala Musical (Web Audio)" : "Synthesized Scale (Web Audio)",
      },
      particles: {
        codeHtml: `<span class="syn-comment">${isEs ? "// 🎆 Explosión física de partículas a 60 FPS" : "// 🎆 60 FPS Particle Physics Burst"}</span>
<span class="syn-keyword">function</span> <span class="syn-fn">emitParticles</span>(count = <span class="syn-num">45</span>, origin = { <span class="syn-prop">x</span>: <span class="syn-num">0.5</span>, <span class="syn-prop">y</span>: <span class="syn-num">0.5</span> }) {
  <span class="syn-keyword">const</span> burst = Array.<span class="syn-fn">from</span>({ length: count }, () => ({
    x: origin.<span class="syn-prop">x</span>, y: origin.<span class="syn-prop">y</span>,
    vx: (Math.<span class="syn-fn">random</span>() - <span class="syn-num">0.5</span>) * <span class="syn-num">14</span>,
    vy: (Math.<span class="syn-fn">random</span>() - <span class="syn-num">0.8</span>) * <span class="syn-num">16</span>,
    gravity: <span class="syn-num">0.45</span>,
    hue: Math.<span class="syn-fn">floor</span>(Math.<span class="syn-fn">random</span>() * <span class="syn-num">360</span>)
  }));
  <span class="syn-keyword">return</span> <span class="syn-fn">renderPhysicsLoop</span>(burst);
}`,
        title: isEs ? "Física de Partículas (Canvas)" : "Particle Physics (Canvas)",
      },
      shake: {
        codeHtml: `<span class="syn-comment">${isEs ? "// 🧲 Física de oscilación elástica gelatina" : "// 🧲 Juicy JELLY Wobble Physics"}</span>
<span class="syn-keyword">function</span> <span class="syn-fn">triggerJellyWobble</span>(element: <span class="syn-type">HTMLElement</span>) {
  element.<span class="syn-prop">classList</span>.<span class="syn-fn">remove</span>(<span class="syn-str">"jelly-active"</span>);
  <span class="syn-fn">void</span> element.<span class="syn-prop">offsetWidth</span>; <span class="syn-comment">// Reflow</span>
  element.<span class="syn-prop">classList</span>.<span class="syn-fn">add</span>(<span class="syn-str">"jelly-active"</span>);

  <span class="syn-keyword">return</span> { <span class="syn-prop">physics</span>: <span class="syn-str">"elastic-squash"</span>, <span class="syn-prop">duration</span>: <span class="syn-str">"650ms"</span> };
}`,
        title: isEs ? "Física Elástica (Jelly)" : "Jelly Wobble Physics",
      },
    };

    let activeSnippetId = "synth";
    let isExecuting = false;

    // --- Interactive Particle System ---
    interface Particle { x: number; y: number; vx: number; vy: number; size: number; color: string; alpha: number; }
    const liveParticles: Particle[] = [];
    const PARTICLE_COLORS = ["#38bdf8", "#f43f5e", "#f59e0b", "#10b981", "#a855f7", "#ffffff"];
    let particleAnimId: number | null = null;

    function resizeCanvas() {
      if (!particleCanvas) return;
      const rect = particleCanvas.getBoundingClientRect();
      particleCanvas.width = rect.width;
      particleCanvas.height = rect.height;
    }

    function addParticles(x: number, y: number, count = 12, speedMult = 1) {
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = (1.5 + Math.random() * 5) * speedMult;
        liveParticles.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 1.5,
          size: 2.5 + Math.random() * 3.5,
          color: PARTICLE_COLORS[Math.floor(Math.random() * PARTICLE_COLORS.length)] || "#38bdf8",
          alpha: 1,
        });
      }
      if (!particleAnimId) {
        animateParticles();
      }
    }

    function animateParticles() {
      if (!particleCanvas) return;
      const ctx = particleCanvas.getContext("2d");
      if (!ctx) return;

      ctx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);
      let aliveCount = 0;

      for (let i = liveParticles.length - 1; i >= 0; i--) {
        const p = liveParticles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.22; // Gravity
        p.alpha -= 0.022;

        if (p.alpha > 0) {
          aliveCount++;
          ctx.save();
          ctx.globalAlpha = p.alpha;
          ctx.fillStyle = p.color;
          ctx.shadowBlur = 6;
          ctx.shadowColor = p.color;
          ctx.fillRect(p.x, p.y, p.size, p.size);
          ctx.restore();
        } else {
          liveParticles.splice(i, 1);
        }
      }

      if (aliveCount > 0) {
        particleAnimId = requestAnimationFrame(animateParticles);
      } else {
        particleAnimId = null;
        ctx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);
      }
    }

    // Cursor interactive spark trail when particles tab is active
    editorBody?.addEventListener("mousemove", (e: MouseEvent) => {
      if (activeSnippetId === "particles" && particleCanvas) {
        const rect = particleCanvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        addParticles(x, y, 2, 0.4);
      }
    });

    editorBody?.addEventListener("click", (e: MouseEvent) => {
      if (activeSnippetId === "particles" && particleCanvas) {
        soundFx.playPop();
        const rect = particleCanvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        addParticles(x, y, 25, 1.2);
      }
    });

    // --- Tab Switcher ---
    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        if (isExecuting) return;
        const id = tab.getAttribute("data-snippet-id") || "synth";
        activeSnippetId = id;
        soundFx.playTap(1300);

        tabs.forEach(t => t.classList.remove("active"));
        tab.classList.add("active");

        const data = SNIPPETS_DATA[id];
        if (data && codeDisplay) {
          codeDisplay.innerHTML = data.codeHtml;
        }

        outputDrawer?.classList.add("hidden");
      });
    });

    // --- Execution Handlers ---
    runBtn?.addEventListener("click", () => {
      if (isExecuting) return;
      const data = SNIPPETS_DATA[activeSnippetId];
      if (!data || !outputLogs) return;

      if (outputTitle) outputTitle.textContent = data.title;
      outputLogs.innerHTML = "";
      outputDrawer?.classList.remove("hidden");

      if (activeSnippetId === "synth") {
        // 🎵 1. Fast Scale Synthesis (C - D - E - F - G) with Inline Colored Notes
        isExecuting = true;
        const NOTES = [
          { name: "C", freq: 523.25, color: "#38bdf8" },
          { name: "D", freq: 587.33, color: "#2dd4bf" },
          { name: "E", freq: 659.25, color: "#10b981" },
          { name: "F", freq: 698.46, color: "#f59e0b" },
          { name: "G", freq: 783.99, color: "#f43f5e" },
        ];

        const streamRow = document.createElement("div");
        streamRow.className = "flex items-center gap-1.5 font-firacode text-xs font-bold py-1";
        streamRow.innerHTML = `<span class="text-foreground/50 mr-1 text-[11px]">${isEs ? "Notas:" : "Notes:"}</span>`;
        outputLogs.appendChild(streamRow);

        NOTES.forEach((note, idx) => {
          setTimeout(() => {
            soundFx.playTap(note.freq);

            const noteSpan = document.createElement("span");
            noteSpan.className = "px-1.5 py-0.5 rounded text-[11px] font-bold shadow-xs";
            noteSpan.style.background = `${note.color}22`;
            noteSpan.style.color = note.color;
            noteSpan.style.border = `1px solid ${note.color}55`;
            noteSpan.textContent = note.name;
            streamRow.appendChild(noteSpan);

            if (idx < NOTES.length - 1) {
              const dash = document.createElement("span");
              dash.className = "text-foreground/40 font-normal";
              dash.textContent = "-";
              streamRow.appendChild(dash);
            }

            if (idx === NOTES.length - 1) {
              isExecuting = false;
            }
          }, idx * 130);
        });

      } else if (activeSnippetId === "particles") {
        // 🎆 2. Kinetic Particle Explosion
        soundFx.playPop();
        resizeCanvas();
        if (particleCanvas) {
          addParticles(particleCanvas.width / 2, particleCanvas.height / 2, 45, 1.4);
        }

        outputLogs.innerHTML = `
          <div class="text-accent font-medium text-[11px]">🎆 ${isEs ? "45 partículas disparadas • Mueve el cursor sobre el editor para lanzar chispas" : "45 particles spawned • Move cursor over editor to spark particles"}</div>
        `;

      } else if (activeSnippetId === "shake") {
        // 🧲 3. JELLY Wobble on the outer container
        isExecuting = true;
        soundFx.playPop();

        const card = (document.querySelector(".hero-widget-card") || rootWidget) as HTMLElement | null;
        if (card) {
          card.classList.remove("jelly-active");
          void card.offsetWidth; // Force CSS reflow
          card.classList.add("jelly-active");
        }

        setTimeout(() => {
          if (card) card.classList.remove("jelly-active");
          isExecuting = false;
        }, 650);

        outputLogs.innerHTML = `
          <div class="text-[#f43f5e] font-medium text-[11px]">🧲 ${isEs ? "Efecto gelatina elástico ejecutado en 650ms ✨" : "Elastic jelly wobble executed in 650ms ✨"}</div>
        `;
      }
    });

    closeOutput?.addEventListener("click", () => {
      soundFx.playTap(900);
      outputDrawer?.classList.add("hidden");
    });

    const resizeObserver = new ResizeObserver(entries => {
      for (const entry of entries) {
        if (entry.contentRect.width > 0 && entry.contentRect.height > 0) {
          resizeCanvas();
        }
      }
    });
    if (particleCanvas) resizeObserver.observe(particleCanvas);

    window.addEventListener("herowidget:change", (e: Event) => {
      const day = (e as CustomEvent).detail?.day;
      if (day === 2) {
        resizeCanvas();
        requestAnimationFrame(resizeCanvas);
      }
    });

    document.addEventListener("astro:before-swap", () => {
      resizeObserver.disconnect();
      if (particleAnimId) cancelAnimationFrame(particleAnimId);
    }, { once: true });
  }

  initCodeSandbox();
  document.addEventListener("astro:page-load", initCodeSandbox);
</script>
