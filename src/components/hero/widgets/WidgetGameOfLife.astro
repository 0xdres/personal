---
/**
 * WidgetGameOfLife.astro
 *
 * Thursday's Hero Widget: Conway's Game of Life Interactive Canvas.
 * Features & Optimizations:
 * - Real-time zero-overhead cellular automaton running at 60 FPS.
 * - 100% Zero-overhead background pause via IntersectionObserver, document.visibilityState and Panel Active Guard.
 * - Interactive drawing: Click and drag across the canvas to spawn living cells.
 * - Preset generation & clearing buttons with soundFx feedback.
 * - Dynamically inherits the active accent color for neon cell evolution.
 */
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale as any);
---

<div id="life-widget-root" class="game-of-life-widget flex flex-col justify-between px-3.5 pb-3.5 pt-1 h-full select-none">
  <!-- Header: Title & Action Chips -->
  <div class="flex items-center justify-between pb-1 px-0.5">
    <div class="flex items-center gap-2">
      <div class="flex size-6.5 items-center justify-center rounded-lg bg-accent/15 border border-accent/30 text-accent text-xs shrink-0 shadow-xs">
        🕹️
      </div>
      <div class="flex flex-col min-w-0">
        <span class="text-[9.5px] uppercase font-bold tracking-wider opacity-50 truncate">
          {t("heroWidget.life.title")}
        </span>
        <span class="font-firacode text-[11px] text-foreground/75 truncate">
          {t("heroWidget.life.drawHint")}
        </span>
      </div>
    </div>

    <!-- Quick Action Buttons -->
    <div class="flex items-center gap-1.5 shrink-0">
      <button
        id="life-random-btn"
        type="button"
        class="px-2 py-0.5 rounded-md bg-accent/10 border border-accent/25 text-[11px] font-bold text-accent hover:bg-accent hover:text-background transition-all duration-200 cursor-pointer shadow-xs active:scale-95"
        title="Spawn random pattern"
      >
        🎲 {t("heroWidget.life.random")}
      </button>
      <button
        id="life-clear-btn"
        type="button"
        class="px-2 py-0.5 rounded-md bg-muted/20 border border-border/30 text-[11px] font-medium text-foreground/70 hover:text-foreground hover:bg-muted/40 transition-all duration-200 cursor-pointer"
        title="Clear canvas"
      >
        🧹 {t("heroWidget.life.clear")}
      </button>
    </div>
  </div>

  <!-- Cellular Automaton Canvas Grid -->
  <div class="relative flex-1 my-1.5 rounded-xl border border-border/15 bg-transparent overflow-hidden cursor-crosshair">
    <canvas id="life-canvas" class="w-full h-full min-h-[110px]"></canvas>
  </div>

  <!-- Footer Generation Counter & Evolution Pulse -->
  <div class="flex items-center justify-between text-[11px] font-firacode text-foreground/60 px-1">
    <span class="flex items-center gap-1.5">
      <span class="size-1.5 rounded-full bg-accent animate-ping"></span>
      <span>Evolution: <strong id="life-gen-counter" class="text-accent">0</strong></span>
    </span>
    <span class="opacity-50">Conway's Universe (60 FPS)</span>
  </div>
</div>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initGameOfLife() {
    const rootEl = document.getElementById("life-widget-root");
    const canvas = document.getElementById("life-canvas") as HTMLCanvasElement | null;
    const randomBtn = document.getElementById("life-random-btn");
    const clearBtn = document.getElementById("life-clear-btn");
    const genCounter = document.getElementById("life-gen-counter");
    if (!canvas || !rootEl) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const cellSize = 8;
    let cols = 0;
    let rows = 0;
    let grid: Uint8Array;
    let nextGrid: Uint8Array;
    let generation = 0;
    let isDrawing = false;
    let animFrame: number | null = null;
    let lastStepTime = 0;

    let isRunning = false;
    let isInViewport = true;
    let isPanelActive = true;

    function resize() {
      if (!canvas) return;
      const parent = canvas.parentElement;
      const w = parent?.clientWidth || 0;
      const h = parent?.clientHeight || 0;
      if (w > 0 && h > 0) {
        canvas.width = w;
        canvas.height = h;
        const newCols = Math.floor(w / cellSize);
        const newRows = Math.floor(h / cellSize);
        if (newCols !== cols || newRows !== rows || !grid || grid.length === 0) {
          cols = newCols;
          rows = newRows;
          grid = new Uint8Array(cols * rows);
          nextGrid = new Uint8Array(cols * rows);
          seedRandom();
        }
      }
    }

    const resizeObserver = new ResizeObserver(entries => {
      for (const entry of entries) {
        if (entry.contentRect.width > 0 && entry.contentRect.height > 0) {
          resize();
        }
      }
    });
    if (canvas.parentElement) resizeObserver.observe(canvas.parentElement);

    function evaluateExecution() {
      if (isPanelActive && !isInViewport && rootEl) {
        const rect = rootEl.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < window.innerHeight) {
          isInViewport = true;
        }
      }
      const shouldRun = isInViewport && isPanelActive && document.visibilityState === "visible";
      if (shouldRun && !isRunning) {
        isRunning = true;
        animFrame = requestAnimationFrame(render);
      } else if (!shouldRun && isRunning) {
        isRunning = false;
        if (animFrame) {
          cancelAnimationFrame(animFrame);
          animFrame = null;
        }
      }
    }

    // 1. Intersection Observer: Pauses when scrolled out of view
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          isInViewport = entry.isIntersecting;
          evaluateExecution();
        });
      },
      { threshold: 0.05 }
    );
    observer.observe(rootEl);

    // 2. Page Visibility: Pauses immediately on background tab
    document.addEventListener("visibilitychange", evaluateExecution);

    // 3. Panel Active Guard: Listens to hero widget changes (Day 4 = Thursday)
    window.addEventListener("herowidget:change", (e: Event) => {
      const day = (e as CustomEvent).detail?.day;
      isPanelActive = day === 4;
      if (isPanelActive) {
        resize();
        requestAnimationFrame(resize);
      }
      evaluateExecution();
    });

    function seedRandom() {
      generation = 0;
      if (!grid) return;
      for (let i = 0; i < grid.length; i++) {
        grid[i] = Math.random() > 0.82 ? 1 : 0;
      }
    }

    function clearGrid() {
      generation = 0;
      if (grid) grid.fill(0);
      if (genCounter) genCounter.textContent = "0";
    }

    function step() {
      if (!grid || !nextGrid) return;
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          let neighbors = 0;
          for (let dy = -1; dy <= 1; dy++) {
            for (let dx = -1; dx <= 1; dx++) {
              if (dx === 0 && dy === 0) continue;
              const nx = (x + dx + cols) % cols;
              const ny = (y + dy + rows) % rows;
              neighbors += grid[ny * cols + nx];
            }
          }

          const idx = y * cols + x;
          const current = grid[idx];
          if (current === 1 && (neighbors === 2 || neighbors === 3)) {
            nextGrid[idx] = 1;
          } else if (current === 0 && neighbors === 3) {
            nextGrid[idx] = 1;
          } else {
            nextGrid[idx] = 0;
          }
        }
      }

      grid.set(nextGrid);
      generation++;
      if (genCounter && generation % 4 === 0) {
        genCounter.textContent = String(generation);
      }
    }

    function render(time: number) {
      if (!ctx || !canvas || !isRunning) return;

      if (time - lastStepTime > 75) {
        step();
        lastStepTime = time;
      }

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const isDark = document.documentElement.getAttribute("data-theme") !== "light";
      ctx.fillStyle = isDark ? "#38bdf8" : "#0284c7";

      if (grid) {
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            if (grid[y * cols + x] === 1) {
              ctx.fillRect(x * cellSize, y * cellSize, cellSize - 1, cellSize - 1);
            }
          }
        }
      }

      if (isRunning) {
        animFrame = requestAnimationFrame(render);
      }
    }

    function addCellAt(clientX: number, clientY: number) {
      if (!canvas || !grid) return;
      const rect = canvas.getBoundingClientRect();
      const x = Math.floor((clientX - rect.left) / cellSize);
      const y = Math.floor((clientY - rect.top) / cellSize);
      if (x >= 0 && x < cols && y >= 0 && y < rows) {
        grid[y * cols + x] = 1;
        soundFx.playTap(1600);
      }
    }

    canvas.addEventListener("mousedown", e => {
      isDrawing = true;
      addCellAt(e.clientX, e.clientY);
    });

    window.addEventListener("mouseup", () => {
      isDrawing = false;
    });

    canvas.addEventListener("mousemove", e => {
      if (isDrawing) {
        addCellAt(e.clientX, e.clientY);
      }
    });

    canvas.addEventListener("touchstart", e => {
      if (e.touches.length > 0) {
        addCellAt(e.touches[0].clientX, e.touches[0].clientY);
      }
    });

    canvas.addEventListener("touchmove", e => {
      if (e.touches.length > 0) {
        addCellAt(e.touches[0].clientX, e.touches[0].clientY);
      }
    });

    randomBtn?.addEventListener("click", () => {
      soundFx.playPop();
      seedRandom();
    });

    clearBtn?.addEventListener("click", () => {
      soundFx.playTap(800);
      clearGrid();
    });

    resize();

    const panel = rootEl.closest(".widget-panel");
    if (panel) isPanelActive = !panel.classList.contains("hidden");
    evaluateExecution();

    document.addEventListener("astro:before-swap", () => {
      observer.disconnect();
      document.removeEventListener("visibilitychange", evaluateExecution);
      if (animFrame) cancelAnimationFrame(animFrame);
    }, { once: true });
  }

  initGameOfLife();
  document.addEventListener("astro:page-load", initGameOfLife);
</script>
