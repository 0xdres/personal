---
/**
 * WidgetLaunchpad.astro
 *
 * Saturday's Hero Widget: Mini Sound Launchpad 4x4.
 * Features:
 * - 16 illuminated silicone pads mapped to a 3-octave Pentatonic scale.
 * - Real-time zero-latency sound synthesis via soundFx.playPentatonicPad().
 * - Auto-sequencer demo melody button.
 * - Reactive glow feedback and mobile haptics.
 */
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale as any);

const PAD_COLORS = [
  "#38bdf8", "#818cf8", "#c084fc", "#f472b6",
  "#22d3ee", "#a78bfa", "#e879f9", "#fb7185",
  "#34d399", "#38bdf8", "#818cf8", "#f43f5e",
  "#4ade80", "#2dd4bf", "#60a5fa", "#e11d48",
];
---

<div class="launchpad-widget flex flex-col justify-between p-4 sm:p-5 h-full select-none">
  <!-- Header: Title & Demo Trigger -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="flex size-7 items-center justify-center rounded-lg bg-accent/15 border border-accent/30 text-accent text-xs">
        🎹
      </div>
      <div class="flex flex-col">
        <span class="text-[10px] uppercase font-bold tracking-wider opacity-50">
          {t("heroWidget.launchpad.title")}
        </span>
        <span class="font-firacode text-[11px] text-foreground/70">
          {t("heroWidget.launchpad.hint")}
        </span>
      </div>
    </div>

    <!-- Demo Play Trigger -->
    <button
      id="launchpad-demo-btn"
      type="button"
      class="flex items-center gap-1 px-2 py-0.5 rounded-md bg-accent/10 border border-accent/25 text-[11px] font-bold text-accent hover:bg-accent hover:text-background transition-all duration-200 cursor-pointer shadow-xs active:scale-95"
    >
      <span>▶</span>
      <span>Demo</span>
    </button>
  </div>

  <!-- 4x4 Grid of Launchpad Pads -->
  <div class="grid grid-cols-4 gap-2 my-2.5 p-2.5 rounded-xl border border-border/30 bg-background/60 backdrop-blur-md">
    {
      Array.from({ length: 16 }).map((_, i) => (
        <button
          type="button"
          class="launchpad-pad relative flex items-center justify-center aspect-square rounded-lg border border-border/30 bg-muted/20 hover:border-accent/60 transition-all duration-100 cursor-pointer active:scale-90"
          data-pad-index={i}
          style={`--pad-color: ${PAD_COLORS[i]};`}
          title={`Pad ${i + 1}`}
        >
          <span class="text-[10px] font-firacode font-bold opacity-35">{i + 1}</span>
          <span class="pad-glow pointer-events-none absolute inset-0 rounded-lg opacity-0 transition-opacity duration-150" aria-hidden="true"></span>
        </button>
      ))
    }
  </div>

  <!-- Footer Info -->
  <div class="flex items-center justify-between text-[11px] font-firacode text-foreground/60 px-1">
    <span class="flex items-center gap-1.5">
      <span class="size-1.5 rounded-full bg-accent animate-pulse"></span>
      <span>Pentatonic Synth Grid</span>
    </span>
    <span class="opacity-50">120 BPM • Web Audio</span>
  </div>
</div>

<style>
  .launchpad-pad.active {
    background: var(--pad-color) !important;
    border-color: var(--pad-color) !important;
    box-shadow: 0 0 16px var(--pad-color);
    transform: scale(0.92);
  }
  .launchpad-pad.active span {
    color: #ffffff;
    opacity: 1;
  }
</style>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initLaunchpad() {
    const pads = document.querySelectorAll(".launchpad-pad");
    const demoBtn = document.getElementById("launchpad-demo-btn");

    function triggerPad(pad: Element, index: number) {
      soundFx.playPentatonicPad(index);
      pad.classList.add("active");
      setTimeout(() => {
        pad.classList.remove("active");
      }, 180);
    }

    pads.forEach(pad => {
      pad.addEventListener("click", () => {
        const idx = Number(pad.getAttribute("data-pad-index") || "0");
        triggerPad(pad, idx);
      });
    });

    // Auto Demo Melody sequence
    demoBtn?.addEventListener("click", () => {
      const melody = [0, 2, 4, 7, 9, 12, 14, 11, 7, 4, 2, 0];
      melody.forEach((noteIdx, step) => {
        setTimeout(() => {
          const target = document.querySelector(`[data-pad-index="${noteIdx}"]`);
          if (target) triggerPad(target, noteIdx);
        }, step * 140);
      });
    });
  }

  initLaunchpad();
  document.addEventListener("astro:page-load", initLaunchpad);
</script>
