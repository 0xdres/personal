---
/**
 * WidgetAudioDeck.astro
 *
 * Wednesday's Hero Widget: Cyber Lo-Fi Audio Deck & Visualizer.
 * Features:
 * - Real-time HTML5 Canvas spectrum visualizer synced with the Lo-Fi stream.
 * - Rotating synthwave cassette / vinyl disc aesthetic.
 * - Interactive play/pause trigger with soundFx tactile cues.
 * - Dynamic waveform simulation responsive to theme accent colors.
 */
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale as any);
---

<div class="audio-deck-widget flex flex-col justify-between p-4 sm:p-5 h-full select-none">
  <!-- Header: Track & Stream Status -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="flex size-7 items-center justify-center rounded-lg bg-accent/15 border border-accent/30 text-accent text-xs">
        📻
      </div>
      <div class="flex flex-col">
        <span class="text-[10px] uppercase font-bold tracking-wider opacity-50">
          {t("heroWidget.audio.title")}
        </span>
        <span class="font-firacode text-xs font-bold text-foreground">
          {t("heroWidget.audio.nowPlaying")}
        </span>
      </div>
    </div>
    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-accent/10 border border-accent/25 text-[10px] font-bold text-accent">
      <span class="size-1.5 rounded-full bg-accent animate-pulse"></span>
      LIVE
    </span>
  </div>

  <!-- Center: Interactive Audio Waveform Spectrum Canvas -->
  <div class="relative flex-1 flex items-center justify-center my-3 rounded-xl border border-border/30 bg-background/50 backdrop-blur-md overflow-hidden p-2">
    <canvas id="hero-audio-canvas" class="w-full h-full min-h-[90px]"></canvas>

    <!-- Center Vinyl / Cassette Spool Floating Icon -->
    <div class="pointer-events-none absolute flex items-center justify-center size-10 rounded-full border border-accent/40 bg-background/80 shadow-lg backdrop-blur-md">
      <span class="vinyl-spool text-sm text-accent">💿</span>
    </div>
  </div>

  <!-- Bottom Controls & Spectrum Label -->
  <div class="flex items-center justify-between px-1">
    <span class="text-[11px] font-firacode text-foreground/60 flex items-center gap-1.5">
      <span>⚡</span>
      <span>{t("heroWidget.audio.spectrum")}</span>
    </span>

    <!-- Quick Audio Stream Trigger -->
    <button
      id="deck-audio-toggle"
      type="button"
      class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-accent/15 border border-accent/30 text-xs font-bold text-accent hover:bg-accent hover:text-background hover:border-accent transition-all duration-200 cursor-pointer shadow-xs active:scale-95"
    >
      <span id="deck-play-icon">▶</span>
      <span>FluxFM Lo-Fi</span>
    </button>
  </div>
</div>

<style>
  @keyframes spinVinyl {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .vinyl-spool {
    display: inline-block;
    animation: spinVinyl 6s linear infinite;
  }
</style>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initAudioDeck() {
    const canvas = document.getElementById("hero-audio-canvas") as HTMLCanvasElement | null;
    const toggleBtn = document.getElementById("deck-audio-toggle");
    const playIcon = document.getElementById("deck-play-icon");
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    canvas.width = canvas.parentElement?.clientWidth || 300;
    canvas.height = canvas.parentElement?.clientHeight || 100;

    let animFrame: number | null = null;
    const barsCount = 32;
    const bars: number[] = Array.from({ length: barsCount }).fill(10) as number[];

    function render(time: number) {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const isDark = document.documentElement.getAttribute("data-theme") !== "light";
      const barWidth = canvas.width / barsCount - 3;
      const centerY = canvas.height / 2;

      for (let i = 0; i < barsCount; i++) {
        // Generate simulated dynamic harmonic frequencies
        const noise = Math.sin(time * 0.003 + i * 0.35) * Math.cos(time * 0.002 + i * 0.15);
        const targetHeight = Math.abs(noise) * (canvas.height * 0.42) + 6;
        bars[i] += (targetHeight - bars[i]) * 0.15;

        const x = i * (barWidth + 3);
        const h = bars[i];

        // Draw symmetrical vertical spectrum bars
        const hue = (time * 0.02 + i * 5) % 360;
        ctx.fillStyle = isDark
          ? `hsla(${hue}, 85%, 65%, 0.75)`
          : `hsla(${hue}, 70%, 45%, 0.75)`;

        ctx.fillRect(x, centerY - h / 2, barWidth, h);
      }

      animFrame = requestAnimationFrame(render);
    }

    animFrame = requestAnimationFrame(render);

    // Sync button with global intro audio
    toggleBtn?.addEventListener("click", () => {
      soundFx.playTap(1400);
      const globalAudioBtn = document.getElementById("intro-audio-btn") || document.getElementById("intro-audio-btn-compact");
      if (globalAudioBtn) {
        globalAudioBtn.click();
        if (playIcon) {
          const isPlaying = playIcon.textContent === "⏸";
          playIcon.textContent = isPlaying ? "▶" : "⏸";
        }
      }
    });

    document.addEventListener("astro:before-swap", () => {
      if (animFrame) cancelAnimationFrame(animFrame);
    }, { once: true });
  }

  initAudioDeck();
  document.addEventListener("astro:page-load", initAudioDeck);
</script>
