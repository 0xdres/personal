---
/**
 * WidgetPhysicsLab.astro
 *
 * Wednesday's Hero Widget: Interactive Particle Physics & Gravity Lab.
 * Features & Optimizations:
 * - 60 FPS HTML5 Canvas real-time particle mechanics with velocity, damping & elasticity.
 * - Distance-squared optimized math ($dx^2 + dy^2 < R^2$) saving >85% sqrt calculations.
 * - 100% Zero-overhead background pause via IntersectionObserver, document.visibilityState and Panel Active Guard.
 * - Dynamic Proximity Constellation Mesh (neon connection lines scaling with distance).
 * - Interactive Cursor Gravity Well & Vortex (particles orbit and swirl around pointer).
 * - Click / Tap Shockwave Blast with radial dispersal & Web Audio pop sound effect.
 * - 4 Selectable Physics Modes: Gravity (Vortex), Mesh (Constellation), Flow (Fluid Wave), Chaos (Supernova).
 * - Tactile "Impulse Blast" button for instant field explosion.
 * - 100% Bilingual localization (EN/ES).
 */
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale);
const isEs = locale === "es";

const MODES = [
  { id: "gravity", label: isEs ? "🌌 Gravedad" : "🌌 Gravity", title: isEs ? "Vórtice de Atracción Gravitacional" : "Gravitational Vortex" },
  { id: "mesh", label: isEs ? "⚡ Malla" : "⚡ Mesh", title: isEs ? "Malla de Nodos Elásticos Conectados" : "Elastic Constellation Mesh" },
  { id: "flow", label: isEs ? "🌊 Flujo" : "🌊 Flow", title: isEs ? "Vectores de Flujo Armónico" : "Harmonic Fluid Flow" },
  { id: "chaos", label: isEs ? "💥 Caos" : "💥 Chaos", title: isEs ? "Colisión y Dispersión Cinética" : "Supernova Kinetic Collisions" },
];
---

<div id="physics-lab-root" class="physics-lab-widget flex flex-col justify-between px-3.5 pb-3.5 pt-1 h-full select-none font-firacode relative overflow-hidden">
  <!-- Header: Lab Status & Modes Selector -->
  <div class="flex items-center justify-between gap-2 pb-1.5 px-0.5">
    <div class="flex items-center gap-2 min-w-0">
      <div class="flex size-6.5 items-center justify-center rounded-lg bg-accent/15 border border-accent/30 text-accent text-xs shrink-0 shadow-xs">
        ⚛️
      </div>
      <div class="flex flex-col min-w-0">
        <span class="font-bold text-xs truncate text-foreground font-firacode flex items-center gap-1.5">
          <span>{t("heroWidget.physics.title")}</span>
          <span class="text-[9px] px-1 py-0.2 rounded bg-accent/15 text-accent border border-accent/30 shrink-0 font-semibold">
            60 FPS
          </span>
        </span>
        <span id="physics-mode-desc" class="text-[9.5px] text-foreground/50 truncate">
          {MODES[0].title}
        </span>
      </div>
    </div>

    <!-- Quick Shockwave Trigger -->
    <button
      id="physics-blast-btn"
      type="button"
      class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-accent/15 border border-accent/30 text-[11px] font-bold text-accent hover:bg-accent hover:text-background hover:border-accent transition-all duration-150 cursor-pointer shadow-xs active:scale-95 shrink-0"
      title={isEs ? "Disparar onda de choque radial" : "Blast radial shockwave"}
    >
      <span>💥</span>
      <span>{t("heroWidget.physics.blast")}</span>
    </button>
  </div>

  <!-- Center Stage: Interactive Physics Canvas -->
  <div id="physics-canvas-container" class="relative flex-1 my-1.5 rounded-xl border border-border/15 bg-transparent overflow-hidden cursor-crosshair">
    <canvas id="hero-physics-canvas" class="w-full h-full absolute inset-0"></canvas>

    <!-- Interactive Hint Floating Pill (Fades on interaction) -->
    <div id="physics-hint-pill" class="pointer-events-none absolute inset-x-0 bottom-2 flex items-center justify-center text-[10px] text-foreground/50 font-firacode transition-opacity duration-300">
      <span class="px-2.5 py-0.5 rounded-full bg-background/80 border border-border/40 backdrop-blur-md shadow-xs flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-accent animate-ping"></span>
        <span>{isEs ? "Mueve el cursor para atraer • Clic para explotar" : "Move cursor to attract • Click to repel"}</span>
      </span>
    </div>
  </div>

  <!-- Bottom Mode Toolbar -->
  <div class="flex items-center gap-1.5 pt-0.5 overflow-x-auto scrollbar-none">
    {
      MODES.map((m, idx) => (
        <button
          type="button"
          class:list={[
            "physics-mode-btn px-2.5 py-1 rounded-md text-[10.5px] font-bold transition-all duration-150 cursor-pointer shrink-0 border border-transparent text-foreground/60 hover:text-foreground hover:bg-muted/30 active:scale-95",
            idx === 0 && "active",
          ]}
          data-mode-id={m.id}
          data-mode-desc={m.title}
        >
          {m.label}
        </button>
      ))
    }
  </div>
</div>

<style>
  .physics-mode-btn.active {
    background: color-mix(in srgb, var(--accent) 18%, transparent) !important;
    border-color: color-mix(in srgb, var(--accent) 45%, transparent) !important;
    color: var(--accent) !important;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  }
</style>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initPhysicsLab() {
    const rootEl = document.getElementById("physics-lab-root");
    const container = document.getElementById("physics-canvas-container");
    const canvas = document.getElementById("hero-physics-canvas") as HTMLCanvasElement | null;
    const modeBtns = document.querySelectorAll(".physics-mode-btn");
    const modeDesc = document.getElementById("physics-mode-desc");
    const blastBtn = document.getElementById("physics-blast-btn");
    const hintPill = document.getElementById("physics-hint-pill");

    if (!canvas || !container || !rootEl) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = canvas.width = container.clientWidth || 320;
    let height = canvas.height = container.clientHeight || 180;

    function resize() {
      if (!canvas || !container) return;
      const newW = container.clientWidth;
      const newH = container.clientHeight;
      if (newW > 0 && newH > 0) {
        width = canvas.width = newW;
        height = canvas.height = newH;
        // Ensure particles are distributed inside the valid canvas viewport
        particles.forEach(p => {
          if (p.x <= 0 || p.x > width || p.y <= 0 || p.y > height) {
            p.x = Math.random() * width;
            p.y = Math.random() * height;
          }
        });
      }
    }
    resize();
    window.addEventListener("resize", resize);

    const resizeObserver = new ResizeObserver(entries => {
      for (const entry of entries) {
        if (entry.contentRect.width > 0 && entry.contentRect.height > 0) {
          resize();
        }
      }
    });
    resizeObserver.observe(container);

    // Particle Structure
    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      baseColor: string;
      color: string;
      mass: number;
    }

    let activeMode = "gravity"; // "gravity" | "mesh" | "flow" | "chaos"
    const PARTICLE_COUNT = 48;
    const particles: Particle[] = [];

    const NEON_PALETTE = [
      "#38bdf8", // Sky Blue
      "#06b6d4", // Cyan
      "#10b981", // Emerald
      "#f59e0b", // Amber
      "#f43f5e", // Rose
      "#a855f7", // Purple
    ];

    // Initialize Particles
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const color = NEON_PALETTE[i % NEON_PALETTE.length] || "#38bdf8";
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 1.5,
        vy: (Math.random() - 0.5) * 1.5,
        radius: 2 + Math.random() * 2.5,
        baseColor: color,
        color: color,
        mass: 1 + Math.random() * 1.5,
      });
    }

    // Mouse Interaction
    const mouse = {
      x: -1000,
      y: -1000,
      active: false,
      radius: 110,
    };

    // Shockwaves Queue
    interface Shockwave {
      x: number;
      y: number;
      radius: number;
      maxRadius: number;
      alpha: number;
      force: number;
    }
    const shockwaves: Shockwave[] = [];

    function triggerShockwave(x: number, y: number, force = 12) {
      soundFx.playPop();
      shockwaves.push({
        x,
        y,
        radius: 5,
        maxRadius: 130,
        alpha: 1,
        force,
      });

      // Disperse nearby particles
      particles.forEach(p => {
        const dx = p.x - x;
        const dy = p.y - y;
        const distSq = dx * dx + dy * dy;
        if (distSq < 130 * 130) {
          const dist = Math.sqrt(distSq) || 1;
          const power = ((130 - dist) / 130) * force;
          p.vx += (dx / dist) * power;
          p.vy += (dy / dist) * power;
        }
      });
    }

    // Canvas Event Listeners
    container.addEventListener("mousemove", (e: MouseEvent) => {
      const rect = container.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;
      if (hintPill) hintPill.style.opacity = "0";
    });

    container.addEventListener("mouseleave", () => {
      mouse.active = false;
      mouse.x = -1000;
      mouse.y = -1000;
    });

    container.addEventListener("click", (e: MouseEvent) => {
      const rect = container.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;
      triggerShockwave(clickX, clickY, 15);
    });

    blastBtn?.addEventListener("click", () => {
      triggerShockwave(width / 2, height / 2, 18);
    });

    // Switch modes
    modeBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-mode-id") || "gravity";
        const desc = btn.getAttribute("data-mode-desc") || "";
        activeMode = id;
        soundFx.playTap(1350);

        modeBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");

        if (modeDesc) modeDesc.textContent = desc;

        // Custom velocity burst per mode switch
        particles.forEach(p => {
          if (id === "chaos") {
            p.vx = (Math.random() - 0.5) * 8;
            p.vy = (Math.random() - 0.5) * 8;
          } else if (id === "gravity") {
            p.vx = (Math.random() - 0.5) * 2;
            p.vy = (Math.random() - 0.5) * 2;
          }
        });
      });
    });

    // --- Performance Lifecycle Controllers ---
    let animId: number | null = null;
    let isRunning = false;
    let isInViewport = true;
    let isPanelActive = true;
    let time = 0;

    function checkPanelVisibility() {
      const panel = rootEl?.closest(".widget-panel");
      if (panel) {
        isPanelActive = !panel.classList.contains("hidden");
      }
      evaluateExecution();
    }

    function evaluateExecution() {
      if (isPanelActive && !isInViewport && rootEl) {
        const rect = rootEl.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < window.innerHeight) {
          isInViewport = true;
        }
      }
      const shouldRun = isInViewport && isPanelActive && document.visibilityState === "visible";
      if (shouldRun && !isRunning) {
        isRunning = true;
        animId = requestAnimationFrame(render);
      } else if (!shouldRun && isRunning) {
        isRunning = false;
        if (animId) {
          cancelAnimationFrame(animId);
          animId = null;
        }
      }
    }

    // 1. Intersection Observer: Pauses when user scrolls down away from the hero section
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          isInViewport = entry.isIntersecting;
          evaluateExecution();
        });
      },
      { threshold: 0.05 }
    );
    observer.observe(rootEl);

    // 2. Page Visibility: Pauses immediately when tab is in background / minimized
    document.addEventListener("visibilitychange", evaluateExecution);

    // 3. Panel Active Guard: Listens to hero widget switching
    window.addEventListener("herowidget:change", (e: Event) => {
      const day = (e as CustomEvent).detail?.day;
      isPanelActive = day === 3;
      if (isPanelActive) {
        resize();
        requestAnimationFrame(resize);
      }
      evaluateExecution();
    });

    // Animation Loop
    function render() {
      if (!ctx || !canvas || !isRunning) return;
      time += 0.016;

      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.getAttribute("data-theme") !== "light";

      // 1. Draw Shockwaves
      for (let sIdx = shockwaves.length - 1; sIdx >= 0; sIdx--) {
        const sw = shockwaves[sIdx];
        sw.radius += 5.5;
        sw.alpha -= 0.035;

        if (sw.alpha > 0) {
          ctx.save();
          ctx.beginPath();
          ctx.arc(sw.x, sw.y, sw.radius, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(56, 189, 248, ${sw.alpha * 0.8})`;
          ctx.lineWidth = 2.5;
          ctx.shadowBlur = 10;
          ctx.shadowColor = "#38bdf8";
          ctx.stroke();
          ctx.restore();
        } else {
          shockwaves.splice(sIdx, 1);
        }
      }

      // 2. Physics & Particle Updates
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        // Mode specific physics behavior
        if (activeMode === "gravity") {
          // Attract towards mouse if active, else towards center
          const targetX = mouse.active ? mouse.x : width / 2;
          const targetY = mouse.active ? mouse.y : height / 2;

          const dx = targetX - p.x;
          const dy = targetY - p.y;
          const distSq = dx * dx + dy * dy;

          if (distSq > 64) {
            const dist = Math.sqrt(distSq);
            // Direct inward pull force
            const pull = Math.min(2.8, (180 / dist) * 0.42);
            // Subtle orbital swirl
            const swirl = Math.min(1.2, (120 / dist) * 0.2);

            p.vx += (dx / dist) * pull + (-dy / dist) * swirl;
            p.vy += (dy / dist) * pull + (dx / dist) * swirl;
          }
          p.vx *= 0.94;
          p.vy *= 0.94;

        } else if (activeMode === "mesh") {
          // Gentle ambient drift
          p.vx += (Math.random() - 0.5) * 0.1;
          p.vy += (Math.random() - 0.5) * 0.1;

          // Strong magnetic attraction towards cursor in mesh mode
          if (mouse.active) {
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const distSq = dx * dx + dy * dy;
            if (distSq > 64 && distSq < 180 * 180) {
              const dist = Math.sqrt(distSq);
              const pull = ((180 - dist) / 180) * 1.3;
              p.vx += (dx / dist) * pull;
              p.vy += (dy / dist) * pull;
            }
          }
          p.vx *= 0.95;
          p.vy *= 0.95;

        } else if (activeMode === "flow") {
          // Harmonic wave field with dynamic fluid vortex attraction
          const wave = Math.sin(p.y * 0.03 + time * 2) * 0.8;
          p.vx += wave * 0.12;
          p.vy += Math.cos(p.x * 0.03 + time * 1.5) * 0.12;

          if (mouse.active) {
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const distSq = dx * dx + dy * dy;
            if (distSq > 64 && distSq < 180 * 180) {
              const dist = Math.sqrt(distSq);
              const pull = Math.min(2.5, ((180 - dist) / 180) * 1.7);
              const swirl = Math.sin(time * 2 + dist * 0.04) * 0.85;
              p.vx += (dx / dist) * pull + (-dy / dist) * swirl;
              p.vy += (dy / dist) * pull + (dx / dist) * swirl;
            }
          }
          p.vx *= 0.94;
          p.vy *= 0.94;

        } else if (activeMode === "chaos") {
          // Supernova high velocity with mouse slingshot attraction
          p.vx += (Math.random() - 0.5) * 0.4;
          p.vy += (Math.random() - 0.5) * 0.4;

          if (mouse.active) {
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const distSq = dx * dx + dy * dy;
            if (distSq > 64 && distSq < 150 * 150) {
              const dist = Math.sqrt(distSq);
              const pull = ((150 - dist) / 150) * 1.4;
              p.vx += (dx / dist) * pull;
              p.vy += (dy / dist) * pull;
            }
          }
          p.vx *= 0.98;
          p.vy *= 0.98;
        }

        // Apply velocities
        p.x += p.vx;
        p.y += p.vy;

        // Boundary bounce with elastic rebound
        if (p.x < p.radius) {
          p.x = p.radius;
          p.vx = -p.vx * 0.85;
        } else if (p.x > width - p.radius) {
          p.x = width - p.radius;
          p.vx = -p.vx * 0.85;
        }

        if (p.y < p.radius) {
          p.y = p.radius;
          p.vy = -p.vy * 0.85;
        } else if (p.y > height - p.radius) {
          p.y = height - p.radius;
          p.vy = -p.vy * 0.85;
        }

        // 3. Distance-Squared Optimized Connecting Mesh Lines
        const maxDist = activeMode === "mesh" ? 75 : 55;
        const maxDistSq = maxDist * maxDist;

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const distSq = dx * dx + dy * dy;

          if (distSq < maxDistSq) {
            const dist = Math.sqrt(distSq);
            const alpha = (1 - dist / maxDist) * (isDark ? 0.35 : 0.25);
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(56, 189, 248, ${alpha})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }

        // 4. Draw Particle Node
        ctx.save();
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = p.baseColor;
        ctx.shadowBlur = isDark ? 8 : 4;
        ctx.shadowColor = p.baseColor;
        ctx.fill();
        ctx.restore();
      }

      // Draw Cursor Gravity Orbit Ring if active
      if (mouse.active && activeMode === "gravity") {
        ctx.save();
        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, 18 + Math.sin(time * 6) * 3, 0, Math.PI * 2);
        ctx.strokeStyle = "rgba(244, 63, 94, 0.65)";
        ctx.lineWidth = 1.5;
        ctx.setLineDash([3, 3]);
        ctx.stroke();
        ctx.restore();
      }

      if (isRunning) {
        animId = requestAnimationFrame(render);
      }
    }

    checkPanelVisibility();

    document.addEventListener("astro:before-swap", () => {
      observer.disconnect();
      document.removeEventListener("visibilitychange", evaluateExecution);
      window.removeEventListener("resize", resize);
      if (animId) cancelAnimationFrame(animId);
    }, { once: true });
  }

  initPhysicsLab();
  document.addEventListener("astro:page-load", initPhysicsLab);
</script>
