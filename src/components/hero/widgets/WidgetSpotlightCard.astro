---
/**
 * WidgetSpotlightCard.astro
 *
 * Friday's Hero Widget: Interactive 3D Holographic Spotlight Card.
 * Features:
 * - Real-time 3D parallax tilt with multi-layer depth (translateZ 3D pop effect).
 * - Dynamic specular light reflection tracking pointer coordinates.
 * - Dynamic fallback to the newest published post if no featured post is marked.
 * - Dynamic tags, reading time, publication date, title, and localized description.
 * - Magnetic action button with tactile sound FX feedback and hover elevation.
 * - Fully accessible and responsive (zero-overhead CPU usage).
 */
import { useTranslations } from "@/i18n/utils";
import type { ContentEntry } from "@/utils/contentEntry";
import { getReadingTime } from "@/utils/readingTime";

interface Props {
  locale?: string;
  featuredPost?: ContentEntry;
}

const { locale = "en", featuredPost } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === "es" ? "/es" : "";
const isEs = locale === "es";

const isFeatured = Boolean(featuredPost && "featured" in featuredPost.data && featuredPost.data.featured);
const title = featuredPost?.data.title || "Vibe Coding: programming with AI at the speed of thought";
const description = featuredPost?.data.description || "Vibe coding is high-level design executed at high speed. It amplifies technical judgment.";
const href = featuredPost ? `${prefix}/posts/${featuredPost.id.replace(/^[a-z]{2}\//, "").replace(/\.md$/, "")}` : `${prefix}/posts/vibe-coding-new-era`;

const tags = featuredPost && "tags" in featuredPost.data && Array.isArray(featuredPost.data.tags) && featuredPost.data.tags.length > 0
  ? featuredPost.data.tags.slice(0, 2)
  : ["ai", "productivity"];

const readingTime = featuredPost?.body
  ? getReadingTime(featuredPost.body, locale)
  : (isEs ? "4 min de lectura" : "4 min read");

const pubDate = featuredPost?.data.pubDatetime ? new Date(featuredPost.data.pubDatetime) : null;
const formattedDate = pubDate
  ? pubDate.toLocaleDateString(isEs ? "es-ES" : "en-US", { month: "short", day: "numeric" })
  : "Friday Drop ✨";
---

<div id="spotlight-widget-root" class="spotlight-widget flex flex-col justify-between px-3.5 pb-3.5 pt-1 h-full select-none" data-spotlight-card>
  <!-- Card Header: Featured Badge & Dynamic Drop Date -->
  <div class="flex items-center justify-between pb-1 px-0.5 z-10">
    <div class="flex items-center gap-1.5">
      <span class:list={[
        "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider shadow-2xs",
        isFeatured
          ? "bg-amber-500/15 border border-amber-500/35 text-amber-500"
          : "bg-accent/15 border border-accent/35 text-accent"
      ]}>
        <span>{isFeatured ? "⭐" : "🚀"}</span>
        <span>{isFeatured ? t("heroWidget.spotlight.badge") : (isEs ? "ÚLTIMO LANZAMIENTO" : "LATEST RELEASE")}</span>
      </span>
    </div>
    <span class="text-[10.5px] font-firacode font-semibold text-foreground/60">
      {formattedDate}
    </span>
  </div>

  <!-- Main 3D Stage Card -->
  <div class="spotlight-card-stage relative flex-1 flex flex-col justify-center my-1">
    <!-- Unclipped Ambient Aura Glow Field for the 3D Card -->
    <div class="spotlight-card-aura pointer-events-none absolute -inset-8 sm:-inset-12 -z-10 rounded-full opacity-65 blur-3xl transition-all duration-500" aria-hidden="true"></div>

    <div class="spotlight-card-inner relative flex flex-col justify-between p-3.5 sm:p-4 rounded-2xl border border-accent/20 bg-linear-to-br from-accent/8 via-background/30 to-accent/4 backdrop-blur-md shadow-lg transition-transform duration-100 ease-out cursor-pointer overflow-hidden group">
      <!-- Dynamic Specular Spotlight Sheen -->
      <div class="spotlight-glow pointer-events-none absolute -inset-full opacity-0 transition-opacity duration-300 z-0" aria-hidden="true"></div>

      <!-- Content Container with 3D Depth -->
      <div class="relative z-10 space-y-1.5 layer-text">
        <h3 class="text-[13.5px] sm:text-[14.5px] font-bold text-foreground line-clamp-2 leading-snug group-hover:text-accent transition-colors duration-200">
          {title}
        </h3>
        <p class="text-[11px] sm:text-[11.5px] text-foreground/75 line-clamp-2 leading-relaxed font-normal">
          {description}
        </p>
      </div>

      <!-- Metadata & Tags Row with 3D Pop -->
      <div class="relative z-10 flex items-center justify-between mt-3 pt-2 border-t border-border/20 text-[11px] font-firacode layer-meta">
        <!-- Tag Badges -->
        <div class="flex items-center gap-1 truncate max-w-[65%]">
          {
            tags.map((tg: string) => (
              <span class="px-1.5 py-0.5 rounded bg-accent/12 border border-accent/25 text-accent text-[10px] font-semibold truncate">
                #{tg}
              </span>
            ))
          }
        </div>

        <!-- Estimated Reading Time -->
        <span class="opacity-60 flex items-center gap-1 shrink-0 text-[10.5px]">
          <span>⏱️</span>
          <span>{readingTime}</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Magnetic Tactile Action Button -->
  <a
    href={href}
    class="spotlight-read-btn relative z-10 flex items-center justify-center gap-2 w-full py-2 rounded-xl bg-accent text-background font-bold text-xs hover:brightness-110 hover:shadow-lg hover:shadow-accent/25 transition-all duration-200 shadow-md shadow-accent/20 active:scale-98 cursor-pointer"
  >
    <span>{t("heroWidget.spotlight.read")}</span>
    <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
  </a>
</div>

<style>
  .spotlight-card-stage {
    perspective: 1000px;
  }

  /* Unclipped Ambient Card Aura Glow */
  .spotlight-card-aura {
    background: radial-gradient(
      circle at var(--glow-x, 50%) var(--glow-y, 50%),
      color-mix(in srgb, var(--accent) 45%, transparent) 0%,
      color-mix(in srgb, var(--accent) 18%, transparent) 45%,
      transparent 75%
    );
    will-change: transform, opacity;
  }

  .spotlight-card-stage:hover .spotlight-card-aura {
    opacity: 0.95;
    transform: scale(1.08);
  }

  .spotlight-card-inner {
    transform-style: preserve-3d;
    will-change: transform;
    box-shadow:
      0 10px 30px -10px color-mix(in srgb, var(--accent) 15%, transparent),
      0 0 1px 1px color-mix(in srgb, var(--border) 20%, transparent);
  }

  .spotlight-card-inner:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow:
      0 18px 40px -10px color-mix(in srgb, var(--accent) 25%, transparent),
      0 0 20px -2px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .layer-text {
    transform: translateZ(28px);
  }

  .layer-meta {
    transform: translateZ(20px);
  }
</style>

<script>
  import { soundFx } from "@/utils/soundFx";

  function initSpotlightWidget() {
    const root = document.getElementById("spotlight-widget-root");
    const inner = root?.querySelector(".spotlight-card-inner") as HTMLElement | null;
    const glow = root?.querySelector(".spotlight-glow") as HTMLElement | null;
    const aura = root?.querySelector(".spotlight-card-aura") as HTMLElement | null;
    const readBtn = root?.querySelector(".spotlight-read-btn");

    if (!root || !inner) return;

    let targetRotateX = 0;
    let targetRotateY = 0;
    let currentRotateX = 0;
    let currentRotateY = 0;
    let animFrame: number | null = null;
    let isHovered = false;

    function updateTilt() {
      // Smooth LERP spring physics
      currentRotateX += (targetRotateX - currentRotateX) * 0.15;
      currentRotateY += (targetRotateY - currentRotateY) * 0.15;

      if (inner) {
        inner.style.transform = `perspective(1000px) rotateX(${currentRotateX.toFixed(2)}deg) rotateY(${currentRotateY.toFixed(2)}deg) scale3d(${isHovered ? "1.025" : "1"}, ${isHovered ? "1.025" : "1"}, 1)`;
      }

      if (Math.abs(targetRotateX - currentRotateX) > 0.01 || Math.abs(targetRotateY - currentRotateY) > 0.01 || isHovered) {
        animFrame = requestAnimationFrame(updateTilt);
      } else {
        animFrame = null;
      }
    }

    function startTiltLoop() {
      if (!animFrame) {
        animFrame = requestAnimationFrame(updateTilt);
      }
    }

    inner.addEventListener("pointermove", (e: PointerEvent) => {
      isHovered = true;
      const rect = inner.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      // 3D Tilt angles (capped at ±12deg for premium feel)
      targetRotateX = ((y - centerY) / centerY) * -12;
      targetRotateY = ((x - centerX) / centerX) * 12;

      // Specular glow following exact cursor position
      if (glow) {
        glow.style.opacity = "0.35";
        glow.style.background = `radial-gradient(circle 220px at ${x}px ${y}px, var(--accent) 0%, transparent 70%)`;
      }

      // External unclipped ambient aura tracking
      if (aura) {
        const auraX = ((x / rect.width) * 100).toFixed(1);
        const auraY = ((y / rect.height) * 100).toFixed(1);
        aura.style.setProperty("--glow-x", `${auraX}%`);
        aura.style.setProperty("--glow-y", `${auraY}%`);
      }

      startTiltLoop();
    });

    inner.addEventListener("pointerleave", () => {
      isHovered = false;
      targetRotateX = 0;
      targetRotateY = 0;
      if (glow) glow.style.opacity = "0";
      startTiltLoop();
    });

    // Clicking inner card also triggers navigation
    inner.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      soundFx.playTap(1400);
      const link = root.querySelector(".spotlight-read-btn") as HTMLAnchorElement | null;
      if (link && link.href) {
        window.location.href = link.href;
      }
    });

    readBtn?.addEventListener("click", () => {
      soundFx.playTap(1500);
    });

    document.addEventListener("astro:before-swap", () => {
      if (animFrame) {
        cancelAnimationFrame(animFrame);
        animFrame = null;
      }
    }, { once: true });
  }

  initSpotlightWidget();
  document.addEventListener("astro:page-load", initSpotlightWidget);
</script>
