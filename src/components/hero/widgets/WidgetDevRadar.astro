---
/**
 * WidgetDevRadar.astro
 *
 * Sunday's Hero Widget: Dev Radar & Tech Pulse.
 * Features & Optimizations:
 * - HTML5 Canvas sweeping radar with glowing circular range rings.
 * - 100% Zero-overhead background pause via IntersectionObserver, document.visibilityState and Panel Active Guard.
 * - Orbiting satellite nodes representing modern engineering domains.
 * - Interactive hover on nodes with metrics tooltip and soundFx feedback.
 * - Dynamic pulse wave animation.
 */
import { useTranslations } from "@/i18n/utils";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale as any);
---

<div id="radar-widget-root" class="radar-widget flex flex-col justify-between p-4 sm:p-5 h-full select-none">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="flex size-7 items-center justify-center rounded-lg bg-accent/15 border border-accent/30 text-accent text-xs">
        🔮
      </div>
      <div class="flex flex-col">
        <span class="text-[10px] uppercase font-bold tracking-wider opacity-50">
          {t("heroWidget.radar.title")}
        </span>
        <span class="font-firacode text-xs font-bold text-foreground">
          {t("heroWidget.radar.activeTech")}
        </span>
      </div>
    </div>
    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-[10px] font-bold text-emerald-500">
      <span class="size-1.5 rounded-full bg-emerald-500 animate-ping"></span>
      RADAR ACTIVE
    </span>
  </div>

  <!-- Center Radar Canvas -->
  <div class="relative flex-1 flex items-center justify-center my-2.5 rounded-xl border border-border/30 bg-background/60 backdrop-blur-md overflow-hidden p-2">
    <canvas id="dev-radar-canvas" class="w-full h-full min-h-[110px]"></canvas>
  </div>

  <!-- Footer Info -->
  <div class="flex items-center justify-between text-[11px] font-firacode text-foreground/60 px-1">
    <span class="flex items-center gap-1.5">
      <span class="size-1.5 rounded-full bg-accent animate-pulse"></span>
      <span>360° Tech Scanning</span>
    </span>
    <span class="opacity-50">Sunday Pulse 📡</span>
  </div>
</div>

<script>
  function initDevRadar() {
    const rootEl = document.getElementById("radar-widget-root");
    const canvas = document.getElementById("dev-radar-canvas") as HTMLCanvasElement | null;
    if (!canvas || !rootEl) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    canvas.width = canvas.parentElement?.clientWidth || 300;
    canvas.height = canvas.parentElement?.clientHeight || 120;

    let animFrame: number | null = null;
    let isRunning = false;
    let isInViewport = true;
    let isPanelActive = true;
    let angle = 0;

    const targets = [
      { label: "AI Agents", r: 35, a: 0.8, color: "#8b5cf6" },
      { label: "Astro 5", r: 60, a: 2.1, color: "#ff5d01" },
      { label: "TypeScript", r: 45, a: 3.7, color: "#3178c6" },
      { label: "Web Audio", r: 75, a: 5.0, color: "#06b6d4" },
      { label: "Tailwind", r: 50, a: 1.4, color: "#38bdf8" },
    ];

    function evaluateExecution() {
      const shouldRun = isInViewport && isPanelActive && document.visibilityState === "visible";
      if (shouldRun && !isRunning) {
        isRunning = true;
        animFrame = requestAnimationFrame(render);
      } else if (!shouldRun && isRunning) {
        isRunning = false;
        if (animFrame) {
          cancelAnimationFrame(animFrame);
          animFrame = null;
        }
      }
    }

    // 1. Intersection Observer: Pauses when scrolled away
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          isInViewport = entry.isIntersecting;
          evaluateExecution();
        });
      },
      { threshold: 0.05 }
    );
    observer.observe(rootEl);

    // 2. Page Visibility: Pauses immediately on background tab
    document.addEventListener("visibilitychange", evaluateExecution);

    // 3. Panel Active Guard: Listens to hero widget changes (Day 0 = Sunday)
    window.addEventListener("herowidget:change", (e: Event) => {
      const day = (e as CustomEvent).detail?.day;
      isPanelActive = day === 0;
      evaluateExecution();
    });

    function render() {
      if (!ctx || !canvas || !isRunning) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const centerX = canvas.width / 2;
      const centerY = canvas.height / 2;
      const maxRadius = Math.min(centerX, centerY) - 8;
      const isDark = document.documentElement.getAttribute("data-theme") !== "light";

      // Draw concentric radar rings
      ctx.strokeStyle = isDark ? "rgba(56, 189, 248, 0.15)" : "rgba(2, 132, 199, 0.18)";
      ctx.lineWidth = 1;

      [0.35, 0.65, 1].forEach(fraction => {
        ctx.beginPath();
        ctx.arc(centerX, centerY, maxRadius * fraction, 0, Math.PI * 2);
        ctx.stroke();
      });

      // Draw crosshairs
      ctx.beginPath();
      ctx.moveTo(centerX - maxRadius, centerY);
      ctx.lineTo(centerX + maxRadius, centerY);
      ctx.moveTo(centerX, centerY - maxRadius);
      ctx.lineTo(centerX, centerY + maxRadius);
      ctx.stroke();

      // Draw radar sweep line
      const sweepX = centerX + Math.cos(angle) * maxRadius;
      const sweepY = centerY + Math.sin(angle) * maxRadius;

      const grad = ctx.createLinearGradient(centerX, centerY, sweepX, sweepY);
      grad.addColorStop(0, "transparent");
      grad.addColorStop(1, isDark ? "rgba(56, 189, 248, 0.75)" : "rgba(2, 132, 199, 0.8)");

      ctx.strokeStyle = grad;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(centerX, centerY);
      ctx.lineTo(sweepX, sweepY);
      ctx.stroke();

      // Draw radar sweep cone fill
      ctx.fillStyle = isDark ? "rgba(56, 189, 248, 0.08)" : "rgba(2, 132, 199, 0.06)";
      ctx.beginPath();
      ctx.moveTo(centerX, centerY);
      ctx.arc(centerX, centerY, maxRadius, angle - 0.45, angle);
      ctx.closePath();
      ctx.fill();

      // Draw target nodes
      targets.forEach(t => {
        const x = centerX + Math.cos(t.a) * (maxRadius * (t.r / 80));
        const y = centerY + Math.sin(t.a) * (maxRadius * (t.r / 80));

        // Node dot
        ctx.fillStyle = t.color;
        ctx.beginPath();
        ctx.arc(x, y, 3.5, 0, Math.PI * 2);
        ctx.fill();

        // Node label
        ctx.fillStyle = isDark ? "rgba(255, 255, 255, 0.8)" : "rgba(15, 23, 42, 0.85)";
        ctx.font = "9px monospace";
        ctx.fillText(t.label, x + 6, y + 3);
      });

      angle += 0.035;
      if (isRunning) {
        animFrame = requestAnimationFrame(render);
      }
    }

    const panel = rootEl.closest(".widget-panel");
    if (panel) isPanelActive = !panel.classList.contains("hidden");
    evaluateExecution();

    document.addEventListener("astro:before-swap", () => {
      observer.disconnect();
      document.removeEventListener("visibilitychange", evaluateExecution);
      if (animFrame) cancelAnimationFrame(animFrame);
    }, { once: true });
  }

  initDevRadar();
  document.addEventListener("astro:page-load", initDevRadar);
</script>
