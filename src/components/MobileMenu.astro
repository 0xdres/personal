---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";
import { useTranslations, getTargetLanguageUrl } from "@/i18n/utils";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale as any);
const targetLocale = locale === "es" ? "en" : "es";
const targetLanguageUrl = getTargetLanguageUrl(Astro.url.pathname, targetLocale);
const langToggleTitle = locale === "es" ? "Switch to English" : "Cambiar a Español";
const langToggleLabel = locale === "es" ? "Switch to English" : "Cambiar a Español";

const isActive = (path: string) => {
  let normalizedCurrent = currentPath;
  if (normalizedCurrent.startsWith("/es/") || normalizedCurrent === "/es") {
    normalizedCurrent = normalizedCurrent.slice(3) || "/";
  }
  const currentPathArray = normalizedCurrent.split("/").filter((p) => p.trim());
  const pathArray = path.split("/").filter((p) => p.trim());
  return normalizedCurrent === path || currentPathArray[0] === pathArray[0];
};
---

<div id="mobile-menu" class="mobile-menu lg:hidden" aria-hidden="true">
  <!-- Overlay/Backdrop -->
  <div class="mobile-menu-backdrop"></div>

  <!-- Floating Glass Panel -->
  <div class="app-layout">
    <div
      class="mobile-menu-panel relative mt-2 w-full mx-auto rounded-2xl border border-white/10 dark:border-white/5 overflow-hidden shadow-2xl"
    >
      <div class="mobile-menu-inner">
        <nav class="mobile-nav-links">
          <a
            href={locale === "es" ? "/es/posts" : "/posts"}
            class:list={["mobile-nav-link", { active: isActive("/posts") }]}
            style="--i:0"
          >
            <span class="mobile-nav-indicator"></span>
            <span>{t("nav.posts")}</span>
          </a>
          <a
            href={locale === "es" ? "/es/tags" : "/tags"}
            class:list={["mobile-nav-link", { active: isActive("/tags") }]}
            style="--i:1"
          >
            <span class="mobile-nav-indicator"></span>
            <span>{t("nav.tags")}</span>
          </a>
          <a
            href={locale === "es" ? "/es/about" : "/about"}
            class:list={["mobile-nav-link", { active: isActive("/about") }]}
            style="--i:2"
          >
            <span class="mobile-nav-indicator"></span>
            <span>{t("nav.about")}</span>
          </a>
          {
            SITE.showArchives && (
              <a
                href={locale === "es" ? "/es/archives" : "/archives"}
                class:list={[
                  "mobile-nav-link",
                  { active: isActive("/archives") },
                ]}
                style="--i:3"
              >
                <span class="mobile-nav-indicator" />
                <span>{t("nav.archives")}</span>
              </a>
            )
          }
          {
            SITE.showGalleries && (
              <a
                href={locale === "es" ? "/es/galleries" : "/galleries"}
                class:list={[
                  "mobile-nav-link",
                  { active: isActive("/galleries") },
                ]}
                style="--i:4"
              >
                <span class="mobile-nav-indicator" />
                <span>{t("nav.galleries")}</span>
              </a>
            )
          }
        </nav>

        <!-- Divider -->
        <div class="mobile-menu-divider"></div>

        <!-- Bottom action row -->
        <div class="mobile-menu-actions">
          <button
            data-search-trigger
            class="mobile-action-btn flex-1 justify-center"
            title={locale === "es" ? "Buscar (⌘K)" : "Search (⌘K)"}
            aria-label={t("nav.openSearch")}
          >
            <IconSearch class="size-4" />
            <span>{t("nav.search")}</span>
          </button>
          <button
            class="shortcuts-trigger mobile-action-btn flex-1 justify-center"
            title={locale === "es" ? "Atajos (?)" : "Shortcuts (?)"}
            aria-label={locale === "es" ? "Abrir guía de atajos de teclado" : "Open keyboard shortcuts guide"}
          >
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" ry="2"></rect>
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 9h.01M11 9h.01M15 9h.01M17 9h.01M7 13h.01M11 13h.01M15 13h.01M17 13h.01M9 16h6" />
            </svg>
            <span>{t("nav.shortcuts")}</span>
          </button>
          <a
            href={targetLanguageUrl}
            class="mobile-action-btn flex-1 justify-center text-xs font-bold font-firacode"
            title={langToggleTitle}
            aria-label={langToggleLabel}
            data-lang-toggle={targetLocale}
          >
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5c-.03.077-.07.154-.114.23-.9 1.54-2.11 3.05-3.535 4.5M6.412 9a14.95 14.95 0 003.535 4.5m0 0a14.973 14.973 0 01-3.298 3.19M6.412 9H3.9M15 9h-2.5" />
            </svg>
            <span>{locale === "es" ? "EN" : "ES"}</span>
          </a>
          {
            SITE.lightAndDarkMode && (
              <button
                id="theme-btn-mobile"
                class="mobile-action-btn flex-1 justify-center"
                title={t("nav.theme")}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="block size-4 dark:hidden" />
                <IconSunHigh class="hidden size-4 dark:block" />
                <span class="block dark:hidden">{locale === "es" ? "Oscuro" : "Dark"}</span>
                <span class="hidden dark:block">{locale === "es" ? "Claro" : "Light"}</span>
              </button>
            )
          }
        </div>

        <!-- Mobile Accent Color Swatch Row -->
        <div class="mobile-accent-picker mt-4 px-1 flex flex-col gap-1.5 select-none">
          <div class="text-[10px] font-firacode font-bold tracking-wider text-foreground/45 uppercase">
            {t("nav.accentColor")}
          </div>
          <div class="flex items-center justify-between gap-1 mt-1 bg-muted/5 border border-border/10 rounded-xl p-2.5">
            <button data-accent-color="blue" class="size-6 rounded-full bg-[#008fec] border border-border/25 relative focus:outline-none" title="Blue"></button>
            <button data-accent-color="green" class="size-6 rounded-full bg-[#10b981] border border-border/25 relative focus:outline-none" title="Green"></button>
            <button data-accent-color="purple" class="size-6 rounded-full bg-[#a855f7] border border-border/25 relative focus:outline-none" title="Purple"></button>
            <button data-accent-color="amber" class="size-6 rounded-full bg-[#f59e0b] border border-border/25 relative focus:outline-none" title="Amber"></button>
            <button data-accent-color="rose" class="size-6 rounded-full bg-[#f43f5e] border border-border/25 relative focus:outline-none" title="Rose"></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ─── Mobile Menu Floating Sheet ─── */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    z-index: 30;
    pointer-events: none;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(0, 0, 0, 0);
    transition: background-color 0.4s ease, opacity 0.4s ease;
    opacity: 0;
    pointer-events: none;
  }

  .mobile-menu.is-open .mobile-menu-backdrop {
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-panel {
    background: color-mix(in srgb, var(--background) 80%, transparent);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top center;
    transition:
      opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0.35s;
    visibility: hidden;
  }

  .mobile-menu.is-open .mobile-menu-panel {
    backdrop-filter: blur(24px) saturate(200%);
    -webkit-backdrop-filter: blur(24px) saturate(200%);
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
  }

  /* ─── Mobile Menu Inner ─── */
  .mobile-menu-inner {
    position: relative;
    padding: 1rem;
  }

  /* ─── Mobile Nav Links ─── */
  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.75rem;
    transition: color 0.1s ease-out, background-color 0.1s ease-out;
    opacity: 0;
    transform: translateY(8px);
  }

  .mobile-menu.is-open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      color 0.1s ease-out,
      background-color 0.1s ease-out;
    transition-delay: calc(0.08s * var(--i, 0) + 0.12s);
  }

  :is(.mobile-nav-link, .mobile-action-btn):hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .mobile-action-btn:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .mobile-nav-link.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .mobile-nav-indicator {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--foreground) 20%, transparent);
    transition: background-color 0.1s ease-out, box-shadow 0.1s ease-out;
    flex-shrink: 0;
  }

  :is(.mobile-nav-link.active, .mobile-nav-link:hover) .mobile-nav-indicator {
    background: var(--accent);
  }

  .mobile-nav-link.active .mobile-nav-indicator {
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  /* ─── Menu Divider ─── */
  .mobile-menu-divider {
    margin: 0.75rem 0.5rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--border) 40%, transparent),
      transparent
    );
  }

  /* ─── Mobile Action Buttons ─── */
  .mobile-menu-actions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  @media (min-width: 480px) {
    .mobile-menu-actions {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .mobile-menu.is-open .mobile-menu-actions {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.35s;
  }

  .mobile-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.625rem;
    border: 1px solid color-mix(in srgb, var(--border) 20%, transparent);
    background: color-mix(in srgb, var(--background) 50%, transparent);
    backdrop-filter: blur(8px);
    transition: color 0.2s ease, background-color 0.2s ease,
      border-color 0.2s ease;
    cursor: pointer;
  }
</style>
