---
import { useTranslations } from "@/i18n/utils";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
---

<div
  id="shortcuts-modal"
  class="shortcuts-modal-overlay"
  role="dialog"
  aria-modal="true"
  aria-label={t("shortcuts.title")}
  data-toast-opened={t("shortcuts.toast.opened")}
  data-toast-closed={t("shortcuts.toast.closed")}
  data-toast-search-closed={t("shortcuts.toast.searchClosed")}
  data-toast-goto-home={t("shortcuts.toast.gotoHome")}
  data-toast-goto-posts={t("shortcuts.toast.gotoPosts")}
  data-toast-goto-tags={t("shortcuts.toast.gotoTags")}
  data-toast-goto-galleries={t("shortcuts.toast.gotoGalleries")}
  data-toast-theme={t("shortcuts.toast.themeChanged")}
  data-toast-lang={t("shortcuts.toast.lang")}
  data-toast-sound-enabled={t("shortcuts.toast.soundFxEnabled")}
  data-toast-sound-muted={t("shortcuts.toast.soundFxMuted")}
  data-toast-konami={t("shortcuts.toast.konami")}
>
  <div class="shortcuts-modal-backdrop" data-shortcuts-close></div>
  <div class="shortcuts-modal-container" data-modal-card>
    <!-- Aurora orbs background -->
    <div class="modal-aurora" aria-hidden="true">
      <div class="modal-aurora-orb modal-aurora-orb-1"></div>
      <div class="modal-aurora-orb modal-aurora-orb-2"></div>
    </div>
    <!-- Cursor-follow glow -->
    <div class="modal-cursor-glow" data-modal-glow aria-hidden="true"></div>
    <!-- Animated border glow -->
    <div class="modal-border-glow" aria-hidden="true"></div>

    <!-- Header -->
    <div class="shortcuts-modal-header">
      <div class="shortcuts-modal-title">
        <span class="keyboard-icon-ring">
          <svg
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
            <line x1="6" y1="8" x2="6" y2="8"></line>
            <line x1="10" y1="8" x2="10" y2="8"></line>
            <line x1="14" y1="8" x2="14" y2="8"></line>
            <line x1="18" y1="8" x2="18" y2="8"></line>
            <line x1="6" y1="12" x2="6" y2="12"></line>
            <line x1="18" y1="12" x2="18" y2="12"></line>
            <line x1="7" y1="16" x2="17" y2="16"></line>
            <line x1="10" y1="12" x2="14" y2="12"></line>
          </svg>
        </span>
        <span class="shortcuts-title-text">{t("shortcuts.title")}</span>
      </div>
      <button
        class="shortcuts-modal-close"
        data-shortcuts-close
        aria-label={t("shortcuts.closeLabel")}
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="shortcuts-modal-body">
      <!-- Mobile Warning Banner -->
      <div class="shortcuts-mobile-warning">
        <svg
          class="size-4 shrink-0 text-amber-500 dark:text-amber-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          ></path>
        </svg>
        <span>{t("shortcuts.mobileWarning")}</span>
      </div>

      <div class="shortcuts-grid">
        <!-- Group 1: General -->
        <div class="shortcuts-group">
          <h3 class="group-title">{t("shortcuts.group.general")}</h3>
          <ul class="shortcuts-list">
            <li>
              <span class="action-desc">{t("shortcuts.action.toggle")}</span>
              <span class="key-combo"><kbd class="kbd-key">?</kbd></span>
            </li>
            <li>
              <span class="action-desc">{t("shortcuts.action.theme")}</span>
              <span class="key-combo"><kbd class="kbd-key">t</kbd></span>
            </li>
            <li>
              <span class="action-desc">{t("shortcuts.action.search")}</span>
              <span class="key-combo"
                ><kbd class="kbd-key">⌘</kbd> <kbd class="kbd-key">K</kbd></span
              >
            </li>
            <li>
              <span class="action-desc">{t("shortcuts.action.close")}</span>
              <span class="key-combo"><kbd class="kbd-key">esc</kbd></span>
            </li>
            <li>
              <span class="action-desc">{t("shortcuts.action.reading")}</span>
              <span class="key-combo"><kbd class="kbd-key">r</kbd></span>
            </li>
            <li>
              <span class="action-desc">{t("shortcuts.action.lang")}</span>
              <span class="key-combo"><kbd class="kbd-key">l</kbd></span>
            </li>
            <!-- Home Shell Terminal Trigger (Key: 'C') -->
            <li>
              <span class="action-desc">{t("shortcuts.action.terminal")}</span>
              <span class="key-combo"><kbd class="kbd-key">c</kbd></span>
            </li>
            <!-- Sound Effects Toggle (Key: 'X') -->
            <li>
              <span class="action-desc">{t("shortcuts.action.soundFx")}</span>
              <span class="key-combo"><kbd class="kbd-key">x</kbd></span>
            </li>
          </ul>
        </div>

        <!-- Group 2: Navigation -->
        <div class="shortcuts-group">
          <h3 class="group-title">{t("shortcuts.group.vim")}</h3>
          <ul class="shortcuts-list">
            <li>
              <span class="action-desc">{t("shortcuts.action.next")}</span>
              <span class="key-combo"><kbd class="kbd-key">j</kbd></span>
            </li>
            <li>
              <span class="action-desc">{t("shortcuts.action.prev")}</span>
              <span class="key-combo"><kbd class="kbd-key">k</kbd></span>
            </li>
            <li>
              <span class="action-desc">{t("shortcuts.action.open")}</span>
              <span class="key-combo"><kbd class="kbd-key">enter</kbd></span>
            </li>
          </ul>
        </div>

        <!-- Group 3: Go To Pages -->
        <div class="shortcuts-group md:col-span-2">
          <h3 class="group-title">
            {t("shortcuts.group.goto")}
            {t("shortcuts.group.gotoHelp").replace("{g}", "g")}
          </h3>
          <ul class="shortcuts-list grid grid-cols-1 gap-x-8 md:grid-cols-2">
            <li>
              <span class="action-desc">{t("shortcuts.action.gotoHome")}</span>
              <span class="key-combo"
                ><kbd class="kbd-key">g</kbd> <kbd class="kbd-key">h</kbd></span
              >
            </li>
            <li>
              <span class="action-desc">{t("shortcuts.action.gotoPosts")}</span>
              <span class="key-combo"
                ><kbd class="kbd-key">g</kbd> <kbd class="kbd-key">p</kbd></span
              >
            </li>
            <li>
              <span class="action-desc">{t("shortcuts.action.gotoTags")}</span>
              <span class="key-combo"
                ><kbd class="kbd-key">g</kbd> <kbd class="kbd-key">t</kbd></span
              >
            </li>
            <li>
              <span class="action-desc"
                >{t("shortcuts.action.gotoGalleries")}</span
              >
              <span class="key-combo"
                ><kbd class="kbd-key">g</kbd> <kbd class="kbd-key">g</kbd></span
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Full-Width Footer / Konami Easter Egg Hint Bar -->
    <div class="shortcuts-modal-footer">
      <div class="konami-hint-wrap">
        <span class="konami-hint-icon">🕹️</span>
        <span class="konami-hint-text">{t("shortcuts.hint.konami")}</span>
      </div>
      <span class="konami-hint-badge">Retro 80s Mode</span>
    </div>
  </div>
</div>

<!-- Centered Viewport Konami Celebration Modal with Confetti -->
<div id="konami-celebration-modal" class="konami-celebration-overlay hidden" aria-hidden="true">
  <canvas id="konami-confetti-canvas" class="konami-confetti-canvas"></canvas>
  <div class="konami-celebration-backdrop" id="konami-celebration-backdrop"></div>
  <div class="konami-celebration-card" data-konami-card>
    <div class="konami-card-glow" aria-hidden="true"></div>
    <div class="konami-trophy-icon">🕹️✨</div>
    <h3 class="konami-title">30 LIVES UNLOCKED!</h3>
    <p class="konami-desc">
      {locale === "es"
        ? "¡Código Konami activado con éxito! Has desbloqueado el tema secreto 'Arcade 80s' y efectos retro ✨"
        : "Konami Code successfully activated! Secret 'Arcade 80s' neon theme & retro visual FX unlocked ✨"}
    </p>
    <div class="konami-keys-badge">
      <span>↑</span><span>↑</span><span>↓</span><span>↓</span><span>←</span><span>→</span><span>←</span><span>→</span><span>B</span><span>A</span>
    </div>
    <button id="konami-close-btn" type="button" class="konami-action-btn">
      {locale === "es" ? "¡A Jugar! 🚀" : "Let's Play! 🚀"}
    </button>
  </div>
</div>

<!-- Global feedback toast container -->
<div id="shortcuts-toast-container" class="toast-container" aria-live="polite">
</div>

<script>
  import { navigate } from "astro:transitions/client";
  import { soundFx } from "@/utils/soundFx";

  let shortcutsCleanup: AbortController | null = null;
  let gPressed = false;
  let gTimeout: number | null = null;

  function initShortcutsModal() {
    if (shortcutsCleanup) shortcutsCleanup.abort();
    shortcutsCleanup = new AbortController();
    const { signal } = shortcutsCleanup;

    const modal = document.getElementById("shortcuts-modal");
    if (!modal) return;

    const toastOpened =
      modal.getAttribute("data-toast-opened") || "Shortcuts panel opened";
    const toastSearchClosed =
      modal.getAttribute("data-toast-search-closed") || "Search modal closed";
    const toastGotoHome =
      modal.getAttribute("data-toast-goto-home") || "Navigating to Home...";
    const toastGotoPosts =
      modal.getAttribute("data-toast-goto-posts") ||
      "Navigating to Articles...";
    const toastGotoTags =
      modal.getAttribute("data-toast-goto-tags") || "Navigating to Tags...";
    const toastGotoGalleries =
      modal.getAttribute("data-toast-goto-galleries") ||
      "Navigating to Galleries...";
    const toastTheme =
      modal.getAttribute("data-toast-theme") || "Theme changed to";
    const toastLang =
      modal.getAttribute("data-toast-lang") || "Switching language...";
    const toastSoundEnabled =
      modal.getAttribute("data-toast-sound-enabled") || "Sound effects enabled 🔊";
    const toastSoundMuted =
      modal.getAttribute("data-toast-sound-muted") || "Sound effects muted 🔇";

    const card = modal.querySelector("[data-modal-card]") as HTMLElement;
    const glow = modal.querySelector("[data-modal-glow]") as HTMLElement;
    const toastContainer = document.getElementById("shortcuts-toast-container");

    // Mouse-follow glow effect on modal card
    if (card && glow) {
      card.addEventListener(
        "mousemove",
        (e: MouseEvent) => {
          requestAnimationFrame(() => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            glow.style.setProperty("--gx", `${x}px`);
            glow.style.setProperty("--gy", `${y}px`);
            glow.style.opacity = "1";
          });
        },
        { signal }
      );

      card.addEventListener(
        "mouseleave",
        () => {
          glow.style.opacity = "0";
        },
        { signal }
      );
    }

    function openModal() {
      // Close other modals first (e.g., search modal)
      document.getElementById("search-modal")?.classList.remove("active");

      modal!.classList.add("active");
      document.body.style.overflow = "hidden";
      soundFx.playTap();
      showToast(["?"], toastOpened);
    }

    function closeModal() {
      modal!.classList.remove("active");
      document.body.style.overflow = "";
    }

    // Close on trigger clicks
    modal.querySelectorAll("[data-shortcuts-close]").forEach(el => {
      el.addEventListener("click", closeModal, { signal });
    });

    // Button triggers inside the page (header, footer, mobile menu)
    document.querySelectorAll(".shortcuts-trigger").forEach(el => {
      el.addEventListener(
        "click",
        (e: Event) => {
          e.preventDefault();
          if (modal!.classList.contains("active")) {
            closeModal();
          } else {
            openModal();
          }
        },
        { signal }
      );
    });

    // Helper to show dynamic toasts
    function showToast(keys: string[], message: string) {
      if (!toastContainer) return;

      const toast = document.createElement("div");
      toast.className = "shortcuts-toast";

      const keysHTML = keys
        .map(key => `<kbd class="toast-kbd">${key}</kbd>`)
        .join(" ");

      toast.innerHTML = `
        <div class="toast-content">
          <span class="toast-keys">${keysHTML}</span>
          <span class="toast-message">${message}</span>
        </div>
        <div class="toast-progress"></div>
      `;

      toastContainer.appendChild(toast);

      // Trigger transition
      requestAnimationFrame(() => {
        toast.classList.add("active");
      });

      // Remove after 3 seconds
      setTimeout(() => {
        toast.classList.remove("active");
        toast.classList.add("exit");

        // Bulletproof removal after exit animation (300ms)
        setTimeout(() => {
          toast.remove();
        }, 300);
      }, 3000);
    }

    // Keyboard event listener
    let konamiIndex = 0;
    let konamiTimeout: number | null = null;
    const KONAMI_SEQUENCE = [
      "ArrowUp",
      "ArrowUp",
      "ArrowDown",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight",
      "ArrowLeft",
      "ArrowRight",
      "b",
      "a",
    ];

    document.addEventListener("keydown", (e: KeyboardEvent) => {
      // Discard auto-repeat events
      if (e.repeat) return;

      // Ignore in form fields/editable elements
      const activeTag = document.activeElement?.tagName;
      const isEditable =
        document.activeElement?.hasAttribute("contenteditable") ||
        activeTag === "INPUT" ||
        activeTag === "TEXTAREA" ||
        activeTag === "SELECT";

      if (isEditable) return;

      // Ignore if modifier keys are pressed to avoid interfering with browser shortcuts
      if (e.metaKey || e.ctrlKey || e.altKey) return;

      const key = e.key;

      // 0. Check Konami Code sequence
      const normalizedKey = key.length === 1 ? key.toLowerCase() : key;
      const targetKonamiKey = KONAMI_SEQUENCE[konamiIndex];
      const normalizedTarget =
        targetKonamiKey.length === 1 ? targetKonamiKey.toLowerCase() : targetKonamiKey;

      if (normalizedKey === normalizedTarget) {
        konamiIndex++;
        if (konamiTimeout) clearTimeout(konamiTimeout);
        konamiTimeout = window.setTimeout(() => {
          konamiIndex = 0;
        }, 2500);

        if (konamiIndex === KONAMI_SEQUENCE.length) {
          konamiIndex = 0;
          if (konamiTimeout) clearTimeout(konamiTimeout);

          e.preventDefault();
          soundFx.play8BitFanfare();

          // Unlock arcade 80s accent theme and save 24h expiration timestamp
          document.documentElement.setAttribute("data-accent", "arcade");
          localStorage.setItem("theme-accent", "arcade");
          localStorage.setItem("konami-unlocked-at", String(Date.now()));

          showKonamiCelebration();
          return;
        }
      } else {
        konamiIndex = 0;
      }

      // Close Konami modal on ESC
      if (key === "Escape") {
        const konamiModal = document.getElementById("konami-celebration-modal");
        if (konamiModal && !konamiModal.classList.contains("hidden")) {
          closeKonamiCelebration();
          return;
        }
      }

        // 1. ESC key -> Close search or shortcuts modals
        if (key === "Escape") {
          const searchModal = document.getElementById("search-modal");
          const searchActive = searchModal?.classList.contains("active");
          const shortcutsActive = modal!.classList.contains("active");

          if (searchActive || shortcutsActive) {
            e.preventDefault();
            if (searchActive) {
              searchModal!.classList.remove("active");
              document.body.style.overflow = "";
              showToast(["esc"], toastSearchClosed);
            }
            if (shortcutsActive) {
              closeModal();
            }
          }
          return;
        }

        // If any modal is active, we restrict general navigation shortcuts (j, k, g, t)
        // to prevent interference with search inputs or other modal actions.
        const isSearchModalActive = document
          .getElementById("search-modal")
          ?.classList.contains("active");
        const isShortcutsModalActive = modal!.classList.contains("active");

        // Toggle shortcuts panel (works even when shortcuts modal is active, but not when search is active)
        if (key === "?" && !isSearchModalActive) {
          e.preventDefault();
          if (isShortcutsModalActive) {
            closeModal();
          } else {
            openModal();
          }
          return;
        }

        if (isSearchModalActive || isShortcutsModalActive) {
          return; // Ignore other navigation shortcuts when modals are open
        }

        // 2. Go-to sequence [g] + [key] -> Handle BEFORE single key actions!
        if (gPressed) {
          gPressed = false;
          if (gTimeout) clearTimeout(gTimeout);

          if (key === "h" || key === "H") {
            e.preventDefault();
            showToast(["g", "h"], toastGotoHome);
            setTimeout(() => {
              navigate("/");
            }, 150);
            return;
          }
          if (key === "p" || key === "P") {
            e.preventDefault();
            showToast(["g", "p"], toastGotoPosts);
            setTimeout(() => {
              navigate("/posts");
            }, 150);
            return;
          }
          if (key === "t" || key === "T") {
            e.preventDefault();
            showToast(["g", "t"], toastGotoTags);
            setTimeout(() => {
              navigate("/tags");
            }, 150);
            return;
          }
          if (key === "g" || key === "G") {
            e.preventDefault();
            showToast(["g", "g"], toastGotoGalleries);
            setTimeout(() => {
              navigate("/galleries");
            }, 150);
            return;
          }
          // Any other key pressed after 'g' clears the state
          return;
        }

        // 3. Single key actions
        // [g] key starts sequence (does not show toast until sequence completes)
        if (key === "g" || key === "G") {
          gPressed = true;
          gTimeout = window.setTimeout(() => {
            gPressed = false;
          }, 1200);
          return;
        }

        // [t] Key -> Toggle Theme
        if (key === "t" || key === "T") {
          e.preventDefault();
          // Find theme toggle button and trigger click
          const themeBtn = document.getElementById(
            "theme-btn"
          ) as HTMLElement | null;
          const themeBtnMobile = document.getElementById(
            "theme-btn-mobile"
          ) as HTMLElement | null;

          if (
            themeBtn &&
            window.getComputedStyle(themeBtn).display !== "none"
          ) {
            themeBtn.click();
          } else if (themeBtnMobile) {
            themeBtnMobile.click();
          }

          // Let's determine the new theme to show a precise toast
          setTimeout(() => {
            const currentTheme = localStorage.getItem("theme") || "dark";
            showToast(["t"], `${toastTheme} ${currentTheme}`);
          }, 50);
          return;
        }

        // [l] Key -> Toggle Language
        if (key === "l" || key === "L") {
          e.preventDefault();
          const langToggle = document.querySelector(
            "[data-lang-toggle]"
          ) as HTMLElement | null;
          if (langToggle) {
            soundFx.playSwitch();
            showToast(["l"], toastLang);
            setTimeout(() => {
              langToggle.click();
            }, 150);
          }
          return;
        }

        // [x] Key -> Toggle Sound Effects
        if (key === "x" || key === "X") {
          e.preventDefault();
          const newState = soundFx.toggle();
          showToast(["x"], newState ? toastSoundEnabled : toastSoundMuted);
          return;
        }

        // Vim navigation [j] / [k]
        if (key === "j" || key === "J") {
          e.preventDefault();
          navigateCards(1);
          soundFx.playTap(1400);
          return;
        }
        if (key === "k" || key === "K") {
          e.preventDefault();
          navigateCards(-1);
          soundFx.playTap(1400);
          return;
        }
      },
      { signal }
    );

    // ===== Konami Celebration Modal & Confetti =====
    const konamiModal = document.getElementById("konami-celebration-modal");
    const konamiCloseBtn = document.getElementById("konami-close-btn");
    const konamiBackdrop = document.getElementById("konami-celebration-backdrop");
    const konamiCanvas = document.getElementById("konami-confetti-canvas") as HTMLCanvasElement | null;
    let konamiAnimFrame: number | null = null;

    /**
     * Spawns a full-screen canvas confetti celebration with physics (gravity, velocity, drag, rotation)
     * using the vibrant retro neon color palette of the Arcade 80s theme.
     */
    function launchKonamiConfetti() {
      if (!konamiCanvas) return;
      const ctx = konamiCanvas.getContext("2d");
      if (!ctx) return;

      konamiCanvas.width = window.innerWidth;
      konamiCanvas.height = window.innerHeight;

      const colors = ["#00f0ff", "#ff007f", "#ffe600", "#a855f7", "#ffffff"];
      interface ConfettiParticle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        size: number;
        color: string;
        alpha: number;
        rotation: number;
        vRot: number;
      }

      const particles: ConfettiParticle[] = [];
      const count = 75;
      const originX = window.innerWidth / 2;
      const originY = window.innerHeight / 2 - 50;

      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 4 + Math.random() * 9;
        particles.push({
          x: originX,
          y: originY,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 3,
          size: 4 + Math.random() * 5,
          color: colors[Math.floor(Math.random() * colors.length)] || "#00f0ff",
          alpha: 1,
          rotation: Math.random() * 360,
          vRot: (Math.random() - 0.5) * 12,
        });
      }

      const start = performance.now();
      const duration = 3000;

      function render(now: number) {
        if (!ctx || !konamiCanvas) return;
        const elapsed = now - start;
        const progress = Math.min(1, elapsed / duration);

        ctx.clearRect(0, 0, konamiCanvas.width, konamiCanvas.height);

        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.22; // gravity
          p.vx *= 0.985;
          p.rotation += p.vRot;
          p.alpha = Math.max(0, 1 - Math.pow(progress, 1.5));

          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rotation * Math.PI) / 180);
          ctx.globalAlpha = p.alpha;
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 1.5);
          ctx.restore();
        });

        if (progress < 1) {
          konamiAnimFrame = requestAnimationFrame(render);
        } else {
          ctx.clearRect(0, 0, konamiCanvas.width, konamiCanvas.height);
        }
      }

      if (konamiAnimFrame) cancelAnimationFrame(konamiAnimFrame);
      konamiAnimFrame = requestAnimationFrame(render);
    }

    /**
     * Displays the centered viewport Konami celebration card and fires the confetti shower.
     * Auto-dismisses safely after 6 seconds if not closed earlier by user interaction.
     */
    function showKonamiCelebration() {
      if (!konamiModal) return;
      konamiModal.classList.remove("hidden");
      launchKonamiConfetti();

      // Auto-dismiss after 6 seconds
      setTimeout(() => {
        closeKonamiCelebration();
      }, 6000);
    }

    /**
     * Hides the Konami celebration modal and cleans up active canvas render frames.
     */
    function closeKonamiCelebration() {
      if (!konamiModal) return;
      konamiModal.classList.add("hidden");
      if (konamiAnimFrame) cancelAnimationFrame(konamiAnimFrame);
    }

    konamiCloseBtn?.addEventListener("click", closeKonamiCelebration, { signal });
    konamiBackdrop?.addEventListener("click", closeKonamiCelebration, { signal });

    // Vim navigation implementation
    function navigateCards(direction: number) {
      const cards = Array.from(document.querySelectorAll(".card-glow"));
      if (cards.length === 0) return;

      const activeElement = document.activeElement;
      // Find which card currently has focus inside it
      let activeIndex = cards.findIndex(card => card.contains(activeElement));

      if (activeIndex === -1) {
        // Nothing focused yet
        activeIndex = direction === 1 ? 0 : cards.length - 1;
      } else {
        activeIndex += direction;
        // Wrap around
        if (activeIndex < 0) activeIndex = cards.length - 1;
        if (activeIndex >= cards.length) activeIndex = 0;
      }

      const targetCard = cards[activeIndex];
      const link = targetCard.querySelector("a[href]") as HTMLElement | null;
      if (link) {
        link.focus();
        link.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }
  }

  // Initialize and clean up on Page Load/Transitions
  document.addEventListener("astro:page-load", initShortcutsModal);
</script>

